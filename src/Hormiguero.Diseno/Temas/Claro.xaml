<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=mscorlib"
>
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Colores y pinceles -->
  <Color x:Key="Hormiguero.PrincipalColor">#2E5C8A</Color>
  <Color x:Key="Hormiguero.PrincipalTextoColor">#FFFFFF</Color>
  <Color x:Key="Hormiguero.AcentoColor">#2F7D4F</Color>
  <Color x:Key="Hormiguero.FondoColor">#F1F4F8</Color>
  <Color x:Key="Hormiguero.SuperficieColor">#FFFFFF</Color>
  <Color x:Key="Hormiguero.BordeColor">#D0D7E2</Color>
  <Color x:Key="Hormiguero.TextoColor">#1F2937</Color>
  <Color x:Key="Hormiguero.TextoSecundarioColor">#4B5563</Color>
  <Color x:Key="Hormiguero.ExitoColor">#3AA76D</Color>
  <Color x:Key="Hormiguero.AvisoColor">#F5A623</Color>
  <Color x:Key="Hormiguero.ErrorColor">#D32F2F</Color>

  <SolidColorBrush
    x:Key="Hormiguero.Principal"
    Color="{StaticResource Hormiguero.PrincipalColor}"
  />
  <SolidColorBrush
    x:Key="Hormiguero.PrincipalTexto"
    Color="{StaticResource Hormiguero.PrincipalTextoColor}"
  />
  <SolidColorBrush x:Key="Hormiguero.Acento" Color="{StaticResource Hormiguero.AcentoColor}" />
  <SolidColorBrush x:Key="Hormiguero.Fondo" Color="{StaticResource Hormiguero.FondoColor}" />
  <SolidColorBrush
    x:Key="Hormiguero.Superficie"
    Color="{StaticResource Hormiguero.SuperficieColor}"
  />
  <SolidColorBrush x:Key="Hormiguero.Borde" Color="{StaticResource Hormiguero.BordeColor}" />
  <SolidColorBrush x:Key="Hormiguero.Texto" Color="{StaticResource Hormiguero.TextoColor}" />
  <SolidColorBrush
    x:Key="Hormiguero.TextoSecundario"
    Color="{StaticResource Hormiguero.TextoSecundarioColor}"
  />
  <SolidColorBrush x:Key="Hormiguero.Exito" Color="{StaticResource Hormiguero.ExitoColor}" />
  <SolidColorBrush x:Key="Hormiguero.Aviso" Color="{StaticResource Hormiguero.AvisoColor}" />
  <SolidColorBrush x:Key="Hormiguero.Error" Color="{StaticResource Hormiguero.ErrorColor}" />

  <!-- Estados de los controles (hoja común Controles.xaml) -->
  <Color x:Key="Hormiguero.PrincipalSuaveColor">#E3ECF5</Color>
  <Color x:Key="Hormiguero.PrincipalPresionadoColor">#234870</Color>
  <Color x:Key="Hormiguero.DesactivadoColor">#F2F2F3</Color>
  <Color x:Key="Hormiguero.BordeDesactivadoColor">#E3E5E8</Color>
  <Color x:Key="Hormiguero.TextoDesactivadoColor">#A0A6B0</Color>
  <Color x:Key="Hormiguero.EncabezadoColor">#F3F4F6</Color>
  <Color x:Key="Hormiguero.ResalteColor">#EEF3F9</Color>
  <SolidColorBrush
    x:Key="Hormiguero.PrincipalSuave"
    Color="{StaticResource Hormiguero.PrincipalSuaveColor}"
  />
  <SolidColorBrush
    x:Key="Hormiguero.PrincipalPresionado"
    Color="{StaticResource Hormiguero.PrincipalPresionadoColor}"
  />
  <SolidColorBrush
    x:Key="Hormiguero.Desactivado"
    Color="{StaticResource Hormiguero.DesactivadoColor}"
  />
  <SolidColorBrush
    x:Key="Hormiguero.BordeDesactivado"
    Color="{StaticResource Hormiguero.BordeDesactivadoColor}"
  />
  <SolidColorBrush
    x:Key="Hormiguero.TextoDesactivado"
    Color="{StaticResource Hormiguero.TextoDesactivadoColor}"
  />
  <SolidColorBrush
    x:Key="Hormiguero.Encabezado"
    Color="{StaticResource Hormiguero.EncabezadoColor}"
  />
  <SolidColorBrush x:Key="Hormiguero.Resalte" Color="{StaticResource Hormiguero.ResalteColor}" />

  <!-- Tamaños -->
  <sys:Double x:Key="Hormiguero.TextoNormal">14</sys:Double>
  <sys:Double x:Key="Hormiguero.TextoTitulo">20</sys:Double>
  <sys:Double x:Key="Hormiguero.AltoBoton">40</sys:Double>
  <sys:Double x:Key="Hormiguero.Espacio">12</sys:Double>
  <CornerRadius x:Key="Hormiguero.Radio">8</CornerRadius>
  <Thickness x:Key="Hormiguero.Margen">12</Thickness>
</ResourceDictionary>
