<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <!-- Hoja común de controles de Hormiguero (fase B-1, D-66). Nace de los estilos que
       Buscadero pulió en su revisión final; los colores salen del tema activo
       (Claro.xaml u Oscuro.xaml) con DynamicResource, así cambian solos con Windows. -->

  <!-- Ventana -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Hormiguero.Fondo}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
  </Style>

  <!-- Botones -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Hormiguero.Superficie}" />
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hormiguero.Borde}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Fondo"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5"
            SnapsToDevicePixels="True"
          >
            <ContentPresenter
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RecognizesAccessKey="True"
            />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter
                TargetName="Fondo"
                Property="Background"
                Value="{DynamicResource Hormiguero.PrincipalSuave}"
              />
              <Setter
                TargetName="Fondo"
                Property="BorderBrush"
                Value="{DynamicResource Hormiguero.Principal}"
              />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter
                TargetName="Fondo"
                Property="Background"
                Value="{DynamicResource Hormiguero.Principal}"
              />
              <Setter
                TargetName="Fondo"
                Property="BorderBrush"
                Value="{DynamicResource Hormiguero.PrincipalPresionado}"
              />
              <Setter Property="Foreground" Value="{DynamicResource Hormiguero.PrincipalTexto}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter
                TargetName="Fondo"
                Property="Background"
                Value="{DynamicResource Hormiguero.Desactivado}"
              />
              <Setter
                TargetName="Fondo"
                Property="BorderBrush"
                Value="{DynamicResource Hormiguero.BordeDesactivado}"
              />
              <Setter Property="Foreground" Value="{DynamicResource Hormiguero.TextoDesactivado}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Campos de texto -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Hormiguero.Superficie}" />
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hormiguero.Borde}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="CaretBrush" Value="{DynamicResource Hormiguero.Principal}" />
    <Style.Triggers>
      <Trigger Property="IsFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Hormiguero.Principal}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Hormiguero.Desactivado}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Listas desplegables: se dejan al estilo Fluent del tema, que ya se pinta bien en
       claro y oscuro (el de WPF clásico ignoraba el fondo y quedaba blanco en oscuro). -->

  <!-- Casillas -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Pestañas -->
  <!-- Textos que no heredan el color de la ventana -->
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
  </Style>

  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hormiguero.Borde}" />
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="Background" Value="{DynamicResource Hormiguero.Fondo}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style TargetType="TabItem">
    <!-- El contenido de cada pestaña hereda el color de la pestaña, no el de la ventana. -->
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border
            x:Name="Fondo"
            Background="Transparent"
            BorderBrush="{DynamicResource Hormiguero.Borde}"
            BorderThickness="0,0,0,2"
            Padding="{TemplateBinding Padding}"
          >
            <ContentPresenter
              x:Name="Contenido"
              ContentSource="Header"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              TextElement.Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter
                TargetName="Fondo"
                Property="BorderBrush"
                Value="{DynamicResource Hormiguero.Principal}"
              />
              <Setter
                TargetName="Contenido"
                Property="TextElement.Foreground"
                Value="{DynamicResource Hormiguero.Principal}"
              />
              <Setter TargetName="Contenido" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter
                TargetName="Fondo"
                Property="Background"
                Value="{DynamicResource Hormiguero.PrincipalSuave}"
              />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Listas con columnas -->
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Hormiguero.Encabezado}" />
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.TextoSecundario}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hormiguero.Borde}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="Background" Value="{DynamicResource Hormiguero.Superficie}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hormiguero.Borde}" />
  </Style>

  <Style TargetType="ListView">
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="Background" Value="{DynamicResource Hormiguero.Superficie}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hormiguero.Borde}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
    <Setter Property="Padding" Value="6,5" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Hormiguero.Resalte}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Hormiguero.PrincipalSuave}" />
        <Setter Property="Foreground" Value="{DynamicResource Hormiguero.Texto}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
