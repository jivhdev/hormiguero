<UserControl
  x:Class="Hormiguero.Archivero.VisorZonas"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{DynamicResource Hormiguero.Fondo}"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Barra de zoom y páginas -->
    <StackPanel
      Grid.Row="0"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Margin="0,0,0,12"
    >
      <Button
        x:Name="BtnZoomMenos"
        Content="−"
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Padding="12,4"
        Margin="0,0,4,0"
        Click="ZoomMenos_Click"
        IsEnabled="False"
      />
      <TextBlock
        x:Name="TxtZoom"
        Text="100 %"
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Foreground="{DynamicResource Hormiguero.Texto}"
        VerticalAlignment="Center"
        Margin="0,0,4,0"
        MinWidth="60"
        TextAlignment="Center"
      />
      <Button
        x:Name="BtnZoomMas"
        Content="+"
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Padding="12,4"
        Margin="0,0,12,0"
        Click="ZoomMas_Click"
        IsEnabled="False"
      />
      <Button
        x:Name="BtnPaginaAnterior"
        Content="Página anterior"
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Padding="12,4"
        Margin="0,0,4,0"
        Click="PaginaAnterior_Click"
        IsEnabled="False"
      />
      <Button
        x:Name="BtnPaginaSiguiente"
        Content="Página siguiente"
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Padding="12,4"
        Margin="0,0,12,0"
        Click="PaginaSiguiente_Click"
        IsEnabled="False"
      />
      <TextBlock
        x:Name="TxtPagina"
        Text=""
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Foreground="{DynamicResource Hormiguero.Texto}"
        VerticalAlignment="Center"
      />
    </StackPanel>

    <!-- La página y, encima, el lienzo donde se marcan las zonas -->
    <ScrollViewer
      Grid.Row="1"
      HorizontalScrollBarVisibility="Auto"
      VerticalScrollBarVisibility="Auto"
    >
      <Grid HorizontalAlignment="Center">
        <Image x:Name="Pagina" Stretch="None" />
        <Canvas
          x:Name="Lienzo"
          Background="Transparent"
          MouseLeftButtonDown="Lienzo_MouseLeftButtonDown"
          MouseMove="Lienzo_MouseMove"
          MouseLeftButtonUp="Lienzo_MouseLeftButtonUp"
          LostMouseCapture="Lienzo_LostMouseCapture"
        />
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
