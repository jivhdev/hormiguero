<Window x:Class="Archivero.Vistas.ResolverDuplicadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivero — Documento duplicado"
        Height="780" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Text="Ya existe un archivo con este nombre en el destino" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Name="TxtRutaConflicto" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"/>

        <!-- Caso-11, punto 2: zoom y desplazamiento en la comparación. El zoom es uno solo para
             los dos documentos (siempre sincronizado); el desplazamiento se sincroniza por defecto
             y se puede soltar si los documentos tienen el dato en lugares distintos. -->
        <Grid Grid.Row="2" Name="PanelComparacion" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ya guardado" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Background="White">
                <ScrollViewer Name="ScrollExistente" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="Scroll_ScrollChanged">
                    <Image Name="ImagenExistente" Stretch="None">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="EscalaExistente" ScaleX="0.4" ScaleY="0.4"/>
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Documento nuevo" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="White">
                <ScrollViewer Name="ScrollNuevo" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="Scroll_ScrollChanged">
                    <Image Name="ImagenNuevo" Stretch="None">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="EscalaNuevo" ScaleX="0.4" ScaleY="0.4"/>
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Zoom (los dos):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider Name="SliderZoom" Minimum="10" Maximum="150" Value="40" Width="200" VerticalAlignment="Center"
                        ValueChanged="SliderZoom_ValueChanged"/>
                <TextBlock Name="TxtZoom" Text="40%" VerticalAlignment="Center" Margin="6,0,16,0" Width="42"/>
                <CheckBox Name="ChkSincronizarScroll" Content="Mover los dos juntos" IsChecked="True" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Caso-5: "Eliminar duplicado" solo se habilita despues de confirmar aca que, tras
             revisarlos lado a lado, son el mismo documento; nunca antes de compararlos. -->
        <CheckBox Grid.Row="3" Name="ChkConfirmarMismoDocumento" Margin="0,8,0,0" Visibility="Collapsed"
                   Content="Confirmo que, tras revisarlos, son el mismo documento"
                   Checked="ChkConfirmarMismoDocumento_Changed" Unchecked="ChkConfirmarMismoDocumento_Changed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="BtnRevisar" Content="Revisar lado a lado" Padding="8,6" Margin="0,0,8,0" Click="BtnRevisar_Click"/>
            <Button Content="Reemplazar" Padding="8,6" Margin="0,0,8,0" Click="BtnReemplazar_Click"/>
            <Button Name="BtnEliminarDuplicado" Content="Eliminar duplicado" Padding="8,6" Margin="0,0,8,0" IsEnabled="False" Click="BtnEliminarDuplicado_Click"/>
            <Button Content="Dejar pendiente" Padding="8,6" Margin="0,0,8,0" Click="BtnDejarPendiente_Click"/>
            <Button Content="Guardar en otra ubicación" Padding="8,6" Click="BtnExcepcion_Click"/>
        </StackPanel>
    </Grid>
</Window>
