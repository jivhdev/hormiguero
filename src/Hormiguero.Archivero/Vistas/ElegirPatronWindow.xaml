<Window x:Class="Archivero.Vistas.ElegirPatronWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivero — Elegir patrón"
        Height="360" Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Esta configuración tiene más de un patrón de reconocimiento (por ejemplo, distintos diseños del mismo proveedor). Elegí cuál querés revisar o corregir:"/>

        <ListBox Grid.Row="1" Name="ListaPatrones" DisplayMemberPath="Descripcion"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Padding="6,6" Click="BtnCancelar_Click"/>
            <Button Content="Elegir" Width="90" Padding="6,6" IsDefault="True" Click="BtnElegir_Click"/>
        </StackPanel>
    </Grid>
</Window>
