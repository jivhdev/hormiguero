<UserControl x:Class="Archivero.Vistas.OrganizacionCarpetaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- 3a: accesos rápidos configurados por el usuario + "Ver todas las opciones" -->
        <StackPanel Name="PanelAccesosRapidos">
            <TextBlock Text="¿Cómo querés organizar las subcarpetas?" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Name="TxtSinAccesosRapidos" Visibility="Collapsed" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Todavía no tenés accesos rápidos configurados. Elegí un tipo en &quot;Ver todas las opciones&quot; y va a quedar a mano para la próxima."/>
            <StackPanel Name="ContenedorAccesosRapidos" Margin="0,0,0,8"/>
            <Button Name="BtnVerTodasLasOpciones" Content="Ver todas las opciones" Padding="6,4" HorizontalAlignment="Left" Click="BtnVerTodas_Click"/>
        </StackPanel>

        <!-- 3b: lista completa de tipos, en el orden exacto del documento -->
        <StackPanel Name="PanelListaCompleta" Visibility="Collapsed">
            <TextBlock Text="Elegir el tipo de organización" FontWeight="Bold" Margin="0,0,0,8"/>
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="ContenedorListaCompleta"/>
            </ScrollViewer>
            <Button Content="Cancelar" Padding="6,4" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnCancelarListaCompleta_Click"/>
        </StackPanel>

        <!-- 3b: enlazado del tipo elegido a un acceso rápido -->
        <StackPanel Name="PanelEnlazar" Visibility="Collapsed">
            <TextBlock Name="TxtTipoPendienteEnlazar" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Name="TxtPreguntaEnlazar" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Name="ContenedorReemplazos" Margin="0,0,0,8"/>
            <Button Name="BtnAgregarAccesoNuevo" Content="Agregar como acceso rápido nuevo" Padding="6,4" HorizontalAlignment="Left" Margin="0,0,0,8" Click="BtnAgregarAccesoNuevo_Click"/>
            <Button Content="Cancelar" Padding="6,4" HorizontalAlignment="Left" Click="BtnCancelarEnlazar_Click"/>
        </StackPanel>

        <!-- 3c/3d: ejemplos concretos del patrón (con la fecha de referencia) -->
        <StackPanel Name="PanelPatron" Visibility="Collapsed">
            <!-- Caso-6, punto 3: el tipo elegido tiene que seguir siendo reelegible sin cancelar
                 el asistente entero (oculto cuando está bloqueado, vinculando a una config existente). -->
            <Button Name="BtnCambiarTipo" Content="← Elegir otro tipo de organización" Padding="0" Margin="0,0,0,8"
                    HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCambiarTipo_Click"/>
            <TextBlock Name="TxtTipoElegido" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Name="TxtAvisoFechaHoy" Visibility="Collapsed" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Estos ejemplos usan la fecha de hoy — marcá la fecha del documento abajo para ver el ejemplo real."/>
            <StackPanel Name="ContenedorEjemplos" Margin="0,0,0,8"/>

            <StackPanel Name="PanelPatronPersonalizado" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="Escribí el patrón a mano:" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox Name="TxtPatronPersonalizado" TextChanged="TxtPatronPersonalizado_TextChanged"/>
                <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"
                           Text="Disponibles: yyyy (año) · yy (año corto) · MM (mes) · MMMM (nombre del mes) · dd (día) · S (semestre) · T (trimestre) · H (quincena) · WW (semana del año) · N (semana del mes) · 'texto' (literal) · \ (separa niveles de carpeta)"/>
                <TextBlock Name="TxtEjemploPersonalizado" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
