<Window x:Class="Archivero.Vistas.GuardarAtajoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivero — Acceso rápido"
        SizeToContent="Height" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="¿Guardar esta configuración como acceso rápido?" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="La carpeta, el tipo de organización y los botones de limpieza de nombre usados esta vez quedan guardados como un botón, para aplicarlos de un click la próxima vez."/>
        <TextBlock Text="Nombre del acceso rápido" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox Name="TxtNombreAtajo" Margin="0,0,0,8"/>
        <TextBlock Name="TxtError" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar acceso rápido" Padding="8,6" Margin="0,0,8,0" IsDefault="True" Click="BtnGuardar_Click"/>
            <Button Content="No, gracias" Padding="8,6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
