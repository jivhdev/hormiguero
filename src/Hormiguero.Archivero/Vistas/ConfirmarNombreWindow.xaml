<Window x:Class="Archivero.Vistas.ConfirmarNombreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Archivero.Vistas"
        Title="Archivero — Confirmar nombre"
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <local:VisorPdfConMarcado Grid.Column="0" x:Name="Visor" Margin="0,0,16,0"/>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Confirmar el nombre del documento" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Name="TxtClasificacion" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="Carpeta" FontWeight="Bold"/>
            <TextBlock Name="TxtCarpeta" TextWrapping="Wrap" Margin="0,2,0,12"/>

            <TextBlock Text="Nombre con el que se guarda el archivo" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox Name="TxtNombre" Margin="0,0,0,12"/>

            <Button Content="Guardar" Padding="8,6" HorizontalAlignment="Left" IsDefault="True" Click="BtnGuardar_Click"/>

            <TextBlock Name="TxtError" Foreground="Red" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Dejar pendiente" Padding="8,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
