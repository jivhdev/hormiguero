<Window
  x:Class="Archivero.Vistas.IdentificarDocumentoWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Archivero.Vistas"
  Title="Archivero — Identificar documento"
  Height="720"
  Width="1080"
  WindowStartupLocation="CenterScreen"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>

    <local:VisorPdfConMarcado x:Name="Visor" Grid.Column="0" Margin="0,0,16,0" />

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock
          Name="TxtTituloPaso"
          FontSize="15"
          FontWeight="Bold"
          Margin="0,0,0,4"
          TextWrapping="Wrap"
        />
        <TextBlock
          Name="TxtInstruccionPaso"
          Foreground="{DynamicResource Hormiguero.TextoSecundario}"
          TextWrapping="Wrap"
          Margin="0,0,0,16"
        />

        <!-- Paso 1: Emisor y Tipo -->
        <StackPanel Name="PanelEmisorTipo">
          <StackPanel Name="PanelCategoriaDocumento">
            <TextBlock Text="Categoría" FontWeight="Bold" Margin="0,0,0,3" />
            <ComboBox
              Name="CmbCategoriaDocumento"
              Margin="0,0,0,10"
              SelectionChanged="CmbCategoriaDocumento_SelectionChanged"
            />
            <TextBlock Text="Documento" FontWeight="Bold" Margin="0,0,0,3" />
            <ListBox
              Name="ListaDocumentos"
              SelectedValuePath="Id"
              DisplayMemberPath="EtiquetaTipo"
              SelectionChanged="ListaDocumentos_SelectionChanged"
              MinHeight="150"
              Margin="0,0,0,8"
            />
            <TextBlock Name="TxtDocumentoElegido" TextWrapping="Wrap" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Name="PanelEmisor">
            <StackPanel Name="PanelGrupo">
              <TextBlock Text="¿Lo emites tú o lo recibes?" FontWeight="Bold" Margin="0,0,0,3" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton
                  Name="RbEmitido"
                  Content="Emitido"
                  IsChecked="True"
                  Margin="0,0,12,0"
                />
                <RadioButton Name="RbRecibido" Content="Recibido" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="1. ¿Quién lo emite?" FontWeight="Bold" />
            <ComboBox
              Name="CmbEmisor"
              IsEditable="True"
              Margin="0,4,0,6"
              TextBoxBase.TextChanged="CmbEmisor_TextChanged"
            />
            <Button
              Name="BtnMarcarEmisor"
              Content="Marcar dónde aparece el emisor en el PDF"
              Margin="0,0,0,4"
              Padding="6,4"
              Click="BtnMarcarEmisor_Click"
            />
            <TextBlock
              Name="TxtEstadoMarcaEmisor"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              Margin="0,0,0,16"
              TextWrapping="Wrap"
            />
            <TextBlock Text="2. ¿Cómo se reconoce?" FontWeight="Bold" />
            <TextBlock
              Text="Marca el título fijo que dice qué documento es (por ejemplo «FACTURA ELECTRÓNICA» o «GUÍA DE DESPACHO»). Con el emisor y el título, Archivero reconocerá solo los próximos documentos iguales."
              TextWrapping="Wrap"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              Margin="0,2,0,6"
            />
            <Button
              Name="BtnMarcarTitulo"
              Content="Marcar el título del documento en el PDF"
              Margin="0,0,0,4"
              Padding="6,4"
              Click="BtnMarcarTitulo_Click"
            />
            <TextBlock
              Name="TxtEstadoMarcaTitulo"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              Margin="0,0,0,16"
              TextWrapping="Wrap"
            />
          </StackPanel>

          <CheckBox Name="ChkSinNumero" Content="Este documento no trae número" Margin="0,0,0,8" />

          <StackPanel Name="PanelNumeroDato" Visibility="Collapsed">
            <TextBlock
              Name="TxtNombreDatoNumero"
              FontSize="18"
              FontWeight="Bold"
              Margin="0,0,0,8"
            />
            <CheckBox
              Name="ChkNumeroEnlazable"
              Content="Se puede enlazar"
              IsChecked="True"
              FontSize="12"
              Margin="0,0,0,8"
              Checked="ChkNumeroEnlazable_Changed"
              Unchecked="ChkNumeroEnlazable_Changed"
            />
            <Button
              Name="BtnMarcarNumero"
              Content="Marcar el número en el PDF"
              Padding="10,8"
              FontSize="16"
              Margin="0,0,0,8"
              Click="BtnMarcarNumero_Click"
            />
            <TextBlock Name="TxtEstadoNumero" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button
              Name="BtnProbarNumeroOtraVez"
              Content="Probar otra vez"
              Padding="8,6"
              Visibility="Collapsed"
              Click="BtnMarcarNumero_Click"
            />
          </StackPanel>

          <Expander
            Name="PanelDatosDiccionario"
            Header="Otros datos que aparecen en este documento"
            Margin="0,12,0,0"
            IsExpanded="False"
          >
            <StackPanel Margin="0,6,0,0">
              <TextBlock Text="Filtrar por categoría" FontWeight="Bold" Margin="0,0,0,3" />
              <ComboBox
                Name="CmbCategoriaOtrosDatos"
                Margin="0,0,0,8"
                SelectionChanged="CmbCategoriaOtrosDatos_SelectionChanged"
              />
              <TextBlock
                Text="Selecciona los datos del diccionario y marca su zona en el PDF."
                Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                TextWrapping="Wrap"
                Margin="0,0,0,6"
              />
              <ItemsControl Name="ListaDatosEnlazantes">
                <ItemsControl.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,4" />
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                      BorderBrush="{DynamicResource Hormiguero.Borde}"
                      BorderThickness="1"
                      Padding="6"
                      Margin="0,0,0,6"
                    >
                      <StackPanel>
                        <CheckBox
                          Content="{Binding Nombre}"
                          IsChecked="{Binding Incluido, UpdateSourceTrigger=PropertyChanged}"
                          Checked="DatoIncluido_Changed"
                          Unchecked="DatoIncluido_Changed"
                        />
                        <CheckBox
                          Content="Se puede enlazar"
                          IsChecked="{Binding Enlazable, UpdateSourceTrigger=PropertyChanged}"
                          Checked="DatoEnlazable_Enlazable_Changed"
                          Unchecked="DatoEnlazable_Enlazable_Changed"
                          Margin="18,0,0,4"
                        />
                        <TextBlock
                          Text="{Binding Estado}"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                          Margin="0,3,0,4"
                        />
                        <StackPanel Orientation="Horizontal">
                          <Button
                            Content="Marcar zona"
                            Padding="5,3"
                            Click="BtnMarcarDatoEnlazante_Click"
                          />
                          <Button
                            Content="Probar otra vez"
                            Padding="5,3"
                            Margin="6,0,0,0"
                            Click="BtnMarcarDatoEnlazante_Click"
                          />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Name="PanelInformativos">
                <TextBlock Text="Datos informativos" FontWeight="Bold" Margin="0,12,0,4" />
                <TextBlock
                  Text="Se leen y muestran, pero no se usan para enlazar documentos."
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                  Margin="0,0,0,6"
                />
                <ItemsControl Name="ListaDatosInformativos">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                        BorderBrush="{DynamicResource Hormiguero.Borde}"
                        BorderThickness="1"
                        Padding="6"
                        Margin="0,0,0,6"
                      >
                        <StackPanel>
                          <CheckBox
                            Content="{Binding Nombre}"
                            IsChecked="{Binding Marcado, UpdateSourceTrigger=PropertyChanged}"
                            Checked="DatoInformativo_Changed"
                            Unchecked="DatoInformativo_Changed"
                          />
                          <TextBlock
                            Text="{Binding Estado}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                            Margin="0,3,0,4"
                          />
                          <Button
                            Content="Marcar zona"
                            Padding="5,3"
                            HorizontalAlignment="Left"
                            Click="BtnMarcarDatoInformativo_Click"
                          />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Expander
                Name="PanelDatosAnteriores"
                Header="Datos propios guardados anteriormente"
                Visibility="Collapsed"
                Margin="0,10,0,0"
              >
                <StackPanel Margin="0,6,0,0">
                  <TextBlock
                    Text="Vincula cada dato a una entrada del diccionario o déjalo sin seleccionar para dejarlo de lado. El historial se conserva."
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                    Margin="0,0,0,6"
                  />
                  <ItemsControl Name="ListaCamposPropios">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                          <TextBlock Text="{Binding Nombre}" />
                          <ComboBox
                            ItemsSource="{Binding OpcionesDatos}"
                            DisplayMemberPath="Value"
                            SelectedValuePath="Key"
                            SelectedValue="{Binding DatoIdSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                          />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Expander>
        </StackPanel>

        <!-- Paso 2 (Caso-3, revisado): carpeta madre + eleccion explicita Directo/Subcarpetas -->
        <StackPanel Name="PanelCarpeta" Visibility="Collapsed">
          <TextBlock Text="Carpeta madre" FontWeight="Bold" />
          <TextBlock
            Text="La carpeta raíz donde va a vivir todo lo de este tipo de documento."
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            TextWrapping="Wrap"
            Margin="0,2,0,0"
          />
          <TextBox Name="TxtCarpetaDestino" IsReadOnly="True" Margin="0,8,0,8" />
          <Button
            Name="BtnElegirCarpeta"
            Content="Elegir carpeta…"
            Padding="6,4"
            HorizontalAlignment="Left"
            Click="BtnElegirCarpeta_Click"
          />

          <TextBlock
            Text="¿Cómo se va a guardar dentro de esa carpeta?"
            FontWeight="Bold"
            Margin="0,16,0,8"
          />
          <RadioButton
            Name="RbGuardarDirecto"
            Checked="RbGuardar_Checked"
            Content="Guardar directo en esta carpeta"
            Margin="0,0,0,6"
          />
          <RadioButton
            Name="RbGuardarSubcarpetas"
            Checked="RbGuardar_Checked"
            Content="Guardar en subcarpetas dentro de esta carpeta"
            Margin="0,0,0,6"
          />
        </StackPanel>

        <!-- Paso 3 (Caso-3, nuevo): tipo de organizacion, patron con ejemplos concretos (control compartido con Caso-4), y fecha de referencia -->
        <StackPanel Name="PanelOrganizacion" Visibility="Collapsed">
          <local:OrganizacionCarpetaControl
            x:Name="ControlOrganizacion"
            SeleccionCambiada="ControlOrganizacion_SeleccionCambiada"
          />

          <StackPanel Name="PanelMarcarFecha">
            <TextBlock Text="Fecha del documento" FontWeight="Bold" />
            <Button
              Name="BtnMarcarFecha"
              Content="Marcar fecha en el PDF"
              Margin="0,4,0,4"
              Padding="6,4"
              Click="BtnMarcarFecha_Click"
            />
            <TextBlock
              Name="TxtEstadoMarcaFecha"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              TextWrapping="Wrap"
            />
            <TextBlock
              Name="TxtFechaOpcional"
              Visibility="Collapsed"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              TextWrapping="Wrap"
              Margin="0,4,0,0"
              Text="Para este tipo de organización la fecha es opcional: si no la marcas, los ejemplos y la vista previa usan la fecha de hoy."
            />
          </StackPanel>
        </StackPanel>

        <!-- Paso 4: Nombre de archivo -->
        <StackPanel Name="PanelNombreArchivo" Visibility="Collapsed">
          <TextBlock
            Text="Nombre con el que se guarda el archivo"
            FontWeight="Bold"
            Margin="0,0,0,8"
          />
          <RadioButton
            Name="RbMantenerNombre"
            Content="Mantener el nombre original"
            Margin="0,0,0,6"
            Checked="OpcionNombre_Changed"
          />
          <RadioButton
            Name="RbExtraerNombre"
            Content="Extraer de una coordenada del PDF"
            Margin="0,0,0,6"
            Checked="OpcionNombre_Changed"
          />
          <RadioButton
            Name="RbPreguntarNombre"
            Content="Preguntar el nombre cada vez"
            Margin="0,0,0,2"
            Checked="OpcionNombre_Changed"
          />
          <TextBlock
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            TextWrapping="Wrap"
            Margin="20,0,0,6"
            Text="La carpeta se sigue eligiendo sola; antes de guardar, el documento queda en &quot;Pendientes por reconocer&quot; para escribir o confirmar su nombre."
          />
          <CheckBox
            Name="ChkAbrirDespuesDeGuardar"
            Content="Abrir el documento después de guardarlo"
            Checked="ChkAbrirDespuesDeGuardar_Changed"
            Unchecked="ChkAbrirDespuesDeGuardar_Changed"
            Margin="0,10,0,0"
          />

          <StackPanel Name="PanelMarcarNombre" Visibility="Collapsed" Margin="0,8,0,0">
            <Button
              Name="BtnMarcarNombreArchivo"
              Content="Marcar el campo en el PDF"
              Margin="0,0,0,4"
              Padding="6,4"
              Click="BtnMarcarNombreArchivo_Click"
            />
            <TextBlock
              Name="TxtEstadoMarcaNombre"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              TextWrapping="Wrap"
            />
          </StackPanel>
        </StackPanel>

        <!-- Paso 5: Confirmar -->
        <StackPanel Name="PanelConfirmar" Visibility="Collapsed">
          <TextBlock Text="Nombre estándar" FontWeight="Bold" Margin="0,0,0,3" />
          <TextBox Name="TxtNombreEstandar" Margin="0,0,0,4" />
          <TextBlock
            Text="Nombre con que este tipo aparece en listas y búsquedas. Puedes acortarlo."
            TextWrapping="Wrap"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            Margin="0,0,0,12"
          />
          <TextBlock Name="TxtResumen" TextWrapping="Wrap" Margin="0,0,0,12" />
          <WrapPanel Margin="0,0,0,12">
            <Button
              Content="Cambiar documento"
              Tag="QueDocumento"
              Click="BtnCambiarPaso_Click"
              Margin="0,0,6,6"
              Padding="6,4"
            />
            <Button
              Content="Cambiar emisor"
              Tag="Emisor"
              Click="BtnCambiarPaso_Click"
              Margin="0,0,6,6"
              Padding="6,4"
            />
            <Button
              Content="Cambiar número"
              Tag="Numero"
              Click="BtnCambiarPaso_Click"
              Margin="0,0,6,6"
              Padding="6,4"
            />
            <Button
              Content="Cambiar otros datos"
              Tag="OtrosDatos"
              Click="BtnCambiarPaso_Click"
              Margin="0,0,6,6"
              Padding="6,4"
            />
            <Button
              Name="BtnCambiarGuardar"
              Content="Cambiar dónde se guarda"
              Tag="Guardar"
              Click="BtnCambiarPaso_Click"
              Margin="0,0,6,6"
              Padding="6,4"
            />
          </WrapPanel>

          <!-- Caso-11, punto 1: con "Preguntar el nombre cada vez", también para este primer documento -->
          <StackPanel Name="PanelNombreEsteDocumento" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="Nombre para este documento" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBox Name="TxtNombreEsteDocumento" />
          </StackPanel>

          <TextBlock Text="Impresión" FontWeight="Bold" Margin="0,12,0,4" />
          <TextBlock Text="Imprimir automáticamente al archivar" />
          <ComboBox
            Name="CmbModoImpresion"
            Margin="0,3,0,8"
            SelectionChanged="CmbModoImpresion_SelectionChanged"
          >
            <ComboBoxItem Content="No" Tag="No" />
            <ComboBoxItem Content="Primera página" Tag="PrimeraPagina" />
            <ComboBoxItem Content="Todo el documento" Tag="TodoElDocumento" />
            <ComboBoxItem Content="Preguntar cada vez" Tag="PreguntarCadaVez" />
          </ComboBox>
          <TextBlock Text="Impresora" />
          <ComboBox
            Name="CmbImpresora"
            Margin="0,3,0,0"
            SelectionChanged="CmbImpresora_SelectionChanged"
          />
        </StackPanel>

        <!-- Preview obligatorio de anterior/actual/futuro (Caso-1, punto 3). Visible desde
                 el paso de Formato en adelante, se actualiza solo al cambiar algo relevante, y
                 tambien con el boton, para ver el efecto en vivo de una correccion. -->
        <Border
          Name="PanelPreview"
          Visibility="Collapsed"
          Margin="0,16,0,0"
          Padding="10"
          Background="{DynamicResource Hormiguero.Encabezado}"
          BorderBrush="{DynamicResource Hormiguero.Borde}"
          BorderThickness="1"
        >
          <StackPanel>
            <TextBlock
              Text="Vista previa de dónde va a quedar guardado"
              FontWeight="Bold"
              Margin="0,0,0,6"
              TextWrapping="Wrap"
            />
            <TextBlock
              Text="Carpeta anterior (ya existente):"
              FontWeight="SemiBold"
              TextWrapping="Wrap"
            />
            <TextBlock
              Name="TxtPreviewAnterior"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              TextWrapping="Wrap"
              Margin="0,0,0,8"
            />
            <TextBlock
              Text="Este documento quedaría en:"
              FontWeight="SemiBold"
              TextWrapping="Wrap"
            />
            <TextBlock Name="TxtPreviewActual" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock
              Name="TxtPreviewFuturaTitulo"
              Text="Cuando llegue el próximo período, se crearía:"
              FontWeight="SemiBold"
              TextWrapping="Wrap"
            />
            <TextBlock
              Name="TxtPreviewFutura"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              TextWrapping="Wrap"
              Margin="0,0,0,8"
            />
            <Button
              Name="BtnActualizarPreview"
              Content="Actualizar vista previa"
              Padding="6,4"
              HorizontalAlignment="Left"
              Click="BtnActualizarPreview_Click"
            />
          </StackPanel>
        </Border>

        <TextBlock
          Name="TxtError"
          Foreground="{DynamicResource Hormiguero.Error}"
          TextWrapping="Wrap"
          Margin="0,16,0,0"
          Visibility="Collapsed"
        />
      </StackPanel>
    </ScrollViewer>

    <StackPanel
      Grid.Row="1"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,16,0,0"
    >
      <Button
        Name="BtnAtras"
        Content="&lt; Atrás"
        Width="90"
        Margin="0,0,8,0"
        Padding="6,6"
        Click="BtnAtras_Click"
      />
      <Button
        Name="BtnPosponer"
        Content="Posponer"
        Width="100"
        Margin="0,0,8,0"
        Padding="6,6"
        Click="BtnPosponer_Click"
      />
      <Button
        Name="BtnCancelar"
        Content="Cancelar"
        Width="100"
        Margin="0,0,8,0"
        Padding="6,6"
        Click="BtnCancelar_Click"
      />
      <Button
        Name="BtnSiguiente"
        Content="Siguiente"
        Width="150"
        Padding="6,6"
        IsDefault="True"
        Click="BtnSiguiente_Click"
      />
    </StackPanel>
  </Grid>
</Window>
