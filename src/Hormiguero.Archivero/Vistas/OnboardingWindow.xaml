<Window x:Class="Archivero.Vistas.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivero — Primera configuración"
        Height="360" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" FontWeight="Bold"
                   Text="Bienvenido a Archivero"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,20" TextWrapping="Wrap"
                   Text="Antes de empezar, hay que elegir dónde va a vivir la carpeta que Archivero va a observar."/>

        <TextBlock Grid.Row="2" Text="Nombre de la carpeta:"/>
        <TextBox Grid.Row="3" Name="TxtNombre" Margin="0,4,0,16"/>

        <TextBlock Grid.Row="4" Text="Ubicación:"/>
        <DockPanel Grid.Row="5" Margin="0,4,0,4">
            <Button DockPanel.Dock="Right" Content="Cambiar…" Padding="12,2" Click="BtnCambiarUbicacion_Click"/>
            <TextBox Name="TxtUbicacion" IsReadOnly="True" Margin="0,0,8,0"/>
        </DockPanel>

        <TextBlock Grid.Row="6" Name="TxtVistaPrevia" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="7" Name="TxtError" Margin="0,8,0,0" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Salir" Width="90" Margin="0,0,8,0" Click="BtnSalir_Click"/>
            <Button Content="Crear carpeta" Width="130" Click="BtnCrear_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
