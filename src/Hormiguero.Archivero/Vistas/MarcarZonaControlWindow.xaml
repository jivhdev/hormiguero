<Window
  x:Class="Archivero.Vistas.MarcarZonaControlWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Archivero.Vistas"
  Title="Marcar zona de control"
  Height="850"
  Width="1200"
  MinHeight="600"
  MinWidth="900"
  WindowStartupLocation="CenterOwner"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <local:VisorPdfConMarcado x:Name="Visor" Grid.Row="0" />
    <TextBlock Grid.Row="1" Text="Texto leído en la zona" FontWeight="Bold" Margin="0,10,0,4" />
    <TextBox
      x:Name="TxtLeido"
      Grid.Row="1"
      Margin="180,8,0,4"
      IsReadOnly="True"
      TextWrapping="Wrap"
    />
    <DockPanel Grid.Row="2" Margin="0,8,0,12">
      <TextBlock Text="Debe decir:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="TxtEsperado" />
    </DockPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" IsCancel="True" Padding="12,5" Margin="0,0,8,0" />
      <Button Content="Guardar zona" IsDefault="True" Padding="12,5" Click="Guardar_Click" />
    </StackPanel>
  </Grid>
</Window>
