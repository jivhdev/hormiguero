<Window
  x:Class="Archivero.Vistas.AdministrarCarpetasObservadasWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Carpetas observadas"
  Height="620"
  Width="900"
  MinHeight="500"
  MinWidth="700"
  WindowStartupLocation="CenterOwner"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
      <TextBlock
        DockPanel.Dock="Top"
        Text="Carpetas observadas"
        FontSize="18"
        FontWeight="Bold"
        Margin="0,0,0,12"
      />
      <ListBox Name="ListaCarpetas" SelectionChanged="ListaCarpetas_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="4">
              <CheckBox
                DockPanel.Dock="Right"
                Content="Activa"
                IsChecked="{Binding Activa}"
                Checked="Activa_Changed"
                Unchecked="Activa_Changed"
                Margin="12,0,4,0"
              />
              <StackPanel>
                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                <TextBlock
                  Text="{Binding Ruta}"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                />
                <TextBlock
                  Text="{Binding Resumen}"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Agregar carpeta…" Click="Agregar_Click" Padding="10,5" Margin="0,0,8,0" />
      <Button Content="Editar…" Click="Editar_Click" Padding="10,5" Margin="0,0,8,0" />
      <Button Content="Quitar" Click="Quitar_Click" Padding="10,5" Margin="0,0,8,0" />
      <Button Content="Listo" Click="Listo_Click" IsDefault="True" Padding="12,5" MinWidth="90" />
    </StackPanel>
  </Grid>
</Window>
