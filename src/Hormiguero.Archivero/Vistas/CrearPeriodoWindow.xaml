<Window x:Class="Archivero.Vistas.CrearPeriodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivero — Período nuevo"
        Height="320" Width="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                    Text="Este documento corresponde a un período que todavía no tiene carpeta" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1">
            <TextBlock Name="TxtCarpetaPeriodo" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"/>
            <TextBlock Text="Crear esta carpeta es siempre una decisión del usuario — Archivero nunca la inventa sola."
                        TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Name="BtnCrearPeriodoActual" Content="Crear esta carpeta y guardar aquí" Padding="8,6" Margin="0,0,0,8" HorizontalAlignment="Stretch" Click="BtnCrearPeriodoActual_Click"/>
            <Button Name="BtnCrearPeriodoActualYSiguiente" Padding="8,6" Margin="0,0,0,8" HorizontalAlignment="Stretch" Click="BtnCrearPeriodoActualYSiguiente_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Elegir carpeta manualmente" Padding="8,6" Margin="0,0,8,0" Click="BtnElegirManualmente_Click"/>
                <Button Content="Dejar pendiente" Padding="8,6" Click="BtnDejarPendiente_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
