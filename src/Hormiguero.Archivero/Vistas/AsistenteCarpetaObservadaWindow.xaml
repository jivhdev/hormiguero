<Window
  x:Class="Archivero.Vistas.AsistenteCarpetaObservadaWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Agregar carpeta observada"
  Height="680"
  Width="850"
  MinHeight="540"
  MinWidth="650"
  WindowStartupLocation="CenterOwner"
>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Name="TxtTitulo" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
      <TextBlock
        Name="TxtAyuda"
        Margin="0,6,0,14"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Hormiguero.TextoSecundario}"
      />
      <TextBlock
        Name="TxtError"
        Visibility="Collapsed"
        Foreground="{DynamicResource Hormiguero.Error}"
        TextWrapping="Wrap"
        Margin="0,0,0,8"
      />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid>
        <StackPanel Name="PasoCarpeta">
          <TextBlock Text="Nombre" />
          <TextBox Name="TxtNombre" Margin="0,4,0,12" />
          <TextBlock Text="Carpeta" />
          <DockPanel Margin="0,4,0,12">
            <Button
              DockPanel.Dock="Right"
              Content="Examinar…"
              Click="Examinar_Click"
              Padding="8,4"
            />
            <TextBox Name="TxtRuta" Margin="0,0,8,0" />
          </DockPanel>
          <CheckBox Name="ChkSubcarpetas" Content="Incluir subcarpetas" Margin="0,0,0,8" />
          <CheckBox
            Name="ChkPeriodo"
            Content="Las subcarpetas cambian por período"
            Margin="0,0,0,8"
          />
          <ComboBox Name="ComboFormato" SelectedIndex="0">
            <ComboBoxItem Content="AAAA\AAAAMM" />
            <ComboBoxItem Content="AAAA\MM" />
            <ComboBoxItem Content="AAAAMM" />
            <ComboBoxItem Content="AAAA" />
          </ComboBox>
        </StackPanel>
        <StackPanel Name="PasoEjemplo" Visibility="Collapsed">
          <Button
            Content="Elegir PDF…"
            Click="ElegirEjemplo_Click"
            Padding="10,6"
            HorizontalAlignment="Left"
          />
          <TextBlock Name="TxtEjemplo" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Name="PasoIdentificacion" Visibility="Collapsed">
          <Button
            Content="Marcar la zona en el PDF"
            Click="MarcarIdentificacion_Click"
            Padding="10,6"
            HorizontalAlignment="Left"
          />
          <TextBlock Name="TxtLeidoIdentificacion" Margin="0,10,0,4" TextWrapping="Wrap" />
          <TextBlock Text="Debe decir:" />
          <TextBox Name="TxtIdentificacion" Margin="0,4,0,12" />
          <TextBlock Text="¿De quién es?" />
          <ComboBox
            Name="ComboEntidad"
            IsEditable="True"
            IsTextSearchEnabled="False"
            StaysOpenOnEdit="True"
            Margin="0,4,0,0"
          />
        </StackPanel>
        <StackPanel Name="PasoCedibles" Visibility="Collapsed">
          <CheckBox
            Name="ChkCedibles"
            Content="Esta carpeta trae copias cedibles"
            Checked="Cedibles_Changed"
            Unchecked="Cedibles_Changed"
            Margin="0,0,0,12"
          />
          <StackPanel Name="PanelCedibles" Visibility="Collapsed">
            <Button
              Content="Elegir un PDF cedible de ejemplo…"
              Click="ElegirCedible_Click"
              Padding="10,6"
              HorizontalAlignment="Left"
            />
            <TextBlock Name="TxtCedible" Margin="0,8,0,12" TextWrapping="Wrap" />
            <Button
              Content="Marcar dónde dice CEDIBLE"
              Click="MarcarCedible_Click"
              Padding="10,6"
              HorizontalAlignment="Left"
            />
            <TextBlock Name="TxtLeidoCedible" Margin="0,10,0,4" TextWrapping="Wrap" />
            <TextBlock Text="Debe decir:" />
            <TextBox Name="TxtCedibleEsperado" Margin="0,4,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Name="PasoDisenos" Visibility="Collapsed">
          <TextBlock Text="Diseños configurados" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ListBox Name="ListaDisenos" MinHeight="120" DisplayMemberPath="Resumen" />
          <WrapPanel Margin="0,10,0,0">
            <Button
              Content="Configurar este documento"
              Click="ConfigurarDocumento_Click"
              Padding="10,6"
              Margin="0,0,8,8"
            />
            <Button
              Content="Agregar otro diseño"
              Click="AgregarDiseno_Click"
              Padding="10,6"
              Margin="0,0,8,8"
            />
            <Button Content="Quitar" Click="QuitarDiseno_Click" Padding="10,6" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Name="PasoAccion" Visibility="Collapsed">
          <TextBlock Text="Al llegar un documento nuevo tuyo" FontWeight="SemiBold" />
          <ComboBox
            Name="ComboAccion"
            SelectedIndex="0"
            Margin="0,6,0,12"
            SelectionChanged="ComboAccion_SelectionChanged"
          >
            <ComboBoxItem Content="Solo registrar" />
            <ComboBoxItem Content="Imprimir primera página" />
            <ComboBoxItem Content="Imprimir todo" />
            <ComboBoxItem Content="Dejar en pendientes de ingresar" />
            <ComboBoxItem Content="Dejar en pendientes e imprimir primera página" />
          </ComboBox>
          <StackPanel Name="PanelImpresora" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="Impresora" FontWeight="SemiBold" />
            <ComboBox Name="ComboImpresora" Margin="0,4,0,0" />
          </StackPanel>
          <TextBlock
            Text="Lo que ya está en la carpeta solo se ingresa a Hormiguero; imprimir o avisar es solo para lo que llegue desde hoy."
            TextWrapping="Wrap"
            Margin="0,0,0,14"
          />
          <TextBlock Name="TxtResumen" TextWrapping="Wrap" />
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Cambiar carpeta" Tag="1" Click="CambiarPaso_Click" Margin="0,0,6,6" />
            <Button
              Content="Cambiar documento"
              Tag="2"
              Click="CambiarPaso_Click"
              Margin="0,0,6,6"
            />
            <Button
              Content="Cambiar identificación"
              Tag="3"
              Click="CambiarPaso_Click"
              Margin="0,0,6,6"
            />
            <Button Content="Cambiar cedibles" Tag="4" Click="CambiarPaso_Click" Margin="0,0,6,6" />
            <Button Content="Cambiar diseños" Tag="5" Click="CambiarPaso_Click" Margin="0,0,6,6" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Name="BtnAtras" Content="Atrás" Click="Atras_Click" Padding="12,6" Margin="0,0,8,0" />
      <Button Content="Cancelar" IsCancel="True" Padding="12,6" Margin="0,0,8,0" />
      <Button
        Name="BtnSiguiente"
        Content="Siguiente"
        IsDefault="True"
        Click="Siguiente_Click"
        Padding="16,6"
      />
    </StackPanel>
  </Grid>
</Window>
