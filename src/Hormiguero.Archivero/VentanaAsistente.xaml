<Window
  x:Class="Hormiguero.Archivero.VentanaAsistente"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Hormiguero.Archivero"
  Title="Identificar documento"
  WindowState="Maximized"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
  FontSize="{DynamicResource Hormiguero.TextoNormal}"
>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>
    <local:VisorZonas x:Name="Visor" />
    <Border
      Grid.Column="1"
      Background="{DynamicResource Hormiguero.Superficie}"
      Padding="{DynamicResource Hormiguero.Margen}"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
          x:Name="TituloPaso"
          FontSize="{DynamicResource Hormiguero.TextoTitulo}"
          TextWrapping="Wrap"
          Margin="0,0,0,16"
        />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <StackPanel x:Name="PasoTipo">
              <TextBlock
                Text="Marca en el documento dónde dice qué tipo de documento es."
                TextWrapping="Wrap"
              />
              <TextBlock x:Name="TextoTipo" TextWrapping="Wrap" Margin="0,8" />
              <Label
                Content="¿Cómo se llama este tipo de documento?"
                Target="{Binding ElementName=NombreTipo}"
              />
              <TextBox x:Name="NombreTipo" />
            </StackPanel>
            <StackPanel x:Name="PasoEmisor" Visibility="Collapsed">
              <TextBlock
                Text="Marca dónde aparece quién emite el documento (puede ser el RUT)."
                TextWrapping="Wrap"
              />
              <TextBlock x:Name="TextoEmisor" TextWrapping="Wrap" Margin="0,8" />
              <Label Content="Nombre del emisor" Target="{Binding ElementName=NombreEmisor}" />
              <ComboBox x:Name="NombreEmisor" IsEditable="True" />
            </StackPanel>
            <StackPanel x:Name="PasoNumero" Visibility="Collapsed">
              <TextBlock Text="Marca dónde está el número del documento." TextWrapping="Wrap" />
              <TextBlock x:Name="TextoNumero" TextWrapping="Wrap" Margin="0,8" />
            </StackPanel>
            <StackPanel x:Name="PasoDestino" Visibility="Collapsed">
              <Button Content="Elegir carpeta" Click="ElegirCarpeta_Click" />
              <TextBlock x:Name="Carpeta" TextWrapping="Wrap" Margin="0,8" />
              <RadioButton
                x:Name="AnioMes"
                GroupName="Forma"
                Content="Año y mes (2026\202610)"
                IsChecked="True"
                Click="Opciones_Click"
              />
              <RadioButton
                x:Name="SoloAnio"
                GroupName="Forma"
                Content="Solo año (2026)"
                Click="Opciones_Click"
              />
              <RadioButton
                x:Name="Directo"
                GroupName="Forma"
                Content="Directo en la carpeta"
                Click="Opciones_Click"
              />
              <RadioButton
                x:Name="FechaHoy"
                GroupName="Fecha"
                Content="El mes sale de hoy"
                IsChecked="True"
                Click="Opciones_Click"
                Margin="0,16,0,0"
              />
              <RadioButton
                x:Name="FechaDocumento"
                GroupName="Fecha"
                Content="El mes sale de una fecha del documento"
                Click="Opciones_Click"
              />
              <StackPanel x:Name="PanelFecha" Visibility="Collapsed" Margin="0,8">
                <TextBlock Text="Marca la fecha en el documento" />
                <TextBlock x:Name="TextoFecha" />
              </StackPanel>
              <TextBlock x:Name="VistaCarpetas" TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
            <StackPanel x:Name="PasoNombre" Visibility="Collapsed">
              <CheckBox x:Name="ParteTipo" Content="Tipo" Click="Opciones_Click" />
              <CheckBox x:Name="ParteEmisor" Content="Emisor" Click="Opciones_Click" />
              <CheckBox
                x:Name="ParteNumero"
                Content="Número"
                IsChecked="True"
                Click="Opciones_Click"
              />
              <CheckBox x:Name="ParteFecha" Content="Fecha" Click="Opciones_Click" />
              <CheckBox x:Name="ParteOriginal" Content="Nombre original" Click="Opciones_Click" />
              <Label Content="Separador" Target="{Binding ElementName=Separador}" />
              <TextBox x:Name="Separador" TextChanged="Separador_TextChanged" />
              <TextBlock x:Name="VistaNombre" TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
          <TextBlock
            x:Name="Aviso"
            Foreground="{DynamicResource Hormiguero.Error}"
            TextWrapping="Wrap"
            Margin="0,0,0,8"
          />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
              x:Name="BtnAtras"
              Content="Atrás"
              Click="Atras_Click"
              Padding="12,8"
              Margin="0,0,8,0"
            />
            <Button
              x:Name="BtnSiguiente"
              Content="Siguiente"
              Click="Siguiente_Click"
              Padding="12,8"
              Margin="0,0,8,0"
            />
            <Button Content="Cancelar" Click="Cancelar_Click" Padding="12,8" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
