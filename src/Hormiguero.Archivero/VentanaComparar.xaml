<Window
  x:Class="Hormiguero.Archivero.VentanaComparar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controles="clr-namespace:Hormiguero.Diseno.Controles;assembly=Hormiguero.Diseno"
  Title="Comparar"
  WindowState="Maximized"
  Background="{DynamicResource Hormiguero.Fondo}"
  PreviewKeyDown="Atajo"
>
  <Grid Margin="{DynamicResource Hormiguero.Margen}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      x:Name="Mensaje"
      Grid.Row="0"
      FontSize="{DynamicResource Hormiguero.TextoTitulo}"
      Foreground="{DynamicResource Hormiguero.Texto}"
      TextWrapping="Wrap"
      Margin="0,0,0,{DynamicResource Hormiguero.Espacio}"
    />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
        Grid.Column="0"
        Background="{DynamicResource Hormiguero.Superficie}"
        BorderBrush="{DynamicResource Hormiguero.Borde}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Hormiguero.Radio}"
        Padding="{DynamicResource Hormiguero.Margen}"
        Margin="0,0,4,0"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,{DynamicResource Hormiguero.Espacio}">
            <TextBlock
              Text="El que llegó"
              FontSize="{DynamicResource Hormiguero.TextoTitulo}"
              Foreground="{DynamicResource Hormiguero.Texto}"
            />
            <TextBlock
              x:Name="RutaLlego"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              TextTrimming="CharacterEllipsis"
            />
          </StackPanel>
          <controles:VisorPdf Grid.Row="1" x:Name="VisorLlego" />
        </Grid>
      </Border>

      <Border
        Grid.Column="1"
        Background="{DynamicResource Hormiguero.Superficie}"
        BorderBrush="{DynamicResource Hormiguero.Borde}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Hormiguero.Radio}"
        Padding="{DynamicResource Hormiguero.Margen}"
        Margin="4,0,0,0"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,{DynamicResource Hormiguero.Espacio}">
            <TextBlock
              Text="El que ya estaba"
              FontSize="{DynamicResource Hormiguero.TextoTitulo}"
              Foreground="{DynamicResource Hormiguero.Texto}"
            />
            <TextBlock
              x:Name="RutaEstaba"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              TextTrimming="CharacterEllipsis"
            />
          </StackPanel>
          <controles:VisorPdf Grid.Row="1" x:Name="VisorEstaba" />
        </Grid>
      </Border>
    </Grid>

    <StackPanel
      Grid.Row="2"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Margin="0,{DynamicResource Hormiguero.Espacio},0,0"
    >
      <Button
        x:Name="BtnDescartar"
        Content="Descartar el que llegó"
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Padding="16,8"
        Margin="0,0,8,0"
        Click="Descartar_Click"
      />
      <Button
        x:Name="BtnGuardarOtro"
        Content="Guardar con otro nombre"
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Padding="16,8"
        Margin="0,0,8,0"
        Click="GuardarOtro_Click"
      />
      <!-- Cerrar (REQ-006, D-62): el botón no hace nada, la comparación se
           cierra con la decisión que el usuario tome. -->
      <Button Content="Cerrar" FontSize="{DynamicResource Hormiguero.TextoNormal}" Padding="16,8" />
    </StackPanel>
  </Grid>
</Window>
