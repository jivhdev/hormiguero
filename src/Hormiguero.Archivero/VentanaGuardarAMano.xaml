<Window
  x:Class="Hormiguero.Archivero.VentanaGuardarAMano"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controles="clr-namespace:Hormiguero.Diseno.Controles;assembly=Hormiguero.Diseno"
  Title="Guardar a mano"
  Width="1100"
  Height="760"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Hormiguero.Fondo}"
>
  <Grid Margin="{DynamicResource Hormiguero.Margen}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>

    <Border
      Grid.Column="0"
      Background="{DynamicResource Hormiguero.Superficie}"
      BorderBrush="{DynamicResource Hormiguero.Borde}"
      BorderThickness="1"
      CornerRadius="{DynamicResource Hormiguero.Radio}"
      Padding="{DynamicResource Hormiguero.Margen}"
      Margin="0,0,4,0"
    >
      <controles:VisorPdf x:Name="Visor" />
    </Border>

    <Border
      Grid.Column="1"
      Background="{DynamicResource Hormiguero.Superficie}"
      BorderBrush="{DynamicResource Hormiguero.Borde}"
      BorderThickness="1"
      CornerRadius="{DynamicResource Hormiguero.Radio}"
      Padding="{DynamicResource Hormiguero.Margen}"
      Margin="4,0,0,0"
    >
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock
            Text="Ubicación"
            FontSize="{DynamicResource Hormiguero.TextoTitulo}"
            Foreground="{DynamicResource Hormiguero.Texto}"
            Margin="0,0,0,8"
          />
          <ComboBox
            x:Name="Ubicaciones"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Padding="4"
            SelectionChanged="Ubicaciones_Changed"
          />
          <Button
            x:Name="BtnCrearUbicacion"
            Content="Crear ubicación"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Padding="16,8"
            HorizontalAlignment="Left"
            Margin="0,8,0,{DynamicResource Hormiguero.Espacio}"
            Click="CrearUbicacion_Click"
          />

          <StackPanel x:Name="PanelFormas" Visibility="Collapsed">
            <RadioButton
              x:Name="FormaAnioYMes"
              Checked="Forma_Changed"
              GroupName="Forma"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Foreground="{DynamicResource Hormiguero.Texto}"
              Margin="0,2"
            >
              Año y mes (2026\202610)
            </RadioButton>
            <RadioButton
              x:Name="FormaSoloAnio"
              Checked="Forma_Changed"
              GroupName="Forma"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Foreground="{DynamicResource Hormiguero.Texto}"
              Margin="0,2"
            >
              Solo año (2026)
            </RadioButton>
            <RadioButton
              x:Name="FormaDirecto"
              Checked="Forma_Changed"
              GroupName="Forma"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Foreground="{DynamicResource Hormiguero.Texto}"
              Margin="0,2"
            >
              Directo en la carpeta
            </RadioButton>
          </StackPanel>

          <TextBlock
            Text="Nombre"
            FontSize="{DynamicResource Hormiguero.TextoTitulo}"
            Foreground="{DynamicResource Hormiguero.Texto}"
            Margin="0,{DynamicResource Hormiguero.Espacio},0,8"
          />
          <TextBox
            x:Name="Nombre"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Padding="4"
            TextChanged="Nombre_Changed"
          />

          <TextBlock
            Text="Fecha"
            FontSize="{DynamicResource Hormiguero.TextoTitulo}"
            Foreground="{DynamicResource Hormiguero.Texto}"
            Margin="0,{DynamicResource Hormiguero.Espacio},0,8"
          />
          <DatePicker
            x:Name="Fecha"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Margin="0,0,0,{DynamicResource Hormiguero.Espacio}"
            SelectedDateChanged="Fecha_Changed"
          />

          <TextBlock
            Text="Se guardará en:"
            FontSize="{DynamicResource Hormiguero.TextoTitulo}"
            Foreground="{DynamicResource Hormiguero.Texto}"
            Margin="0,0,0,8"
          />
          <TextBlock
            x:Name="Vista"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            TextWrapping="Wrap"
            Margin="0,0,0,{DynamicResource Hormiguero.Espacio}"
          />

          <StackPanel Orientation="Horizontal">
            <Button
              x:Name="BtnGuardar"
              Content="Guardar"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Padding="16,8"
              IsEnabled="False"
              Margin="0,0,8,0"
              Click="Guardar_Click"
            />
            <Button
              x:Name="BtnCancelar"
              Content="Cancelar"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Padding="16,8"
              Click="Cancelar_Click"
            />
          </StackPanel>

          <TextBlock
            x:Name="Aviso"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Foreground="{DynamicResource Hormiguero.Aviso}"
            TextWrapping="Wrap"
            Margin="0,8,0,0"
          />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
