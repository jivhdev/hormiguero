<Window
  x:Class="Archivero.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Archivero"
  Icon="pack://application:,,,/Archivero;component/Recursos/icono.ico"
  Height="740"
  Width="860"
  WindowStartupLocation="CenterScreen"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="100" />
      <RowDefinition Height="100" />
      <RowDefinition Height="100" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,4">
      <ComboBox
        Name="ComboTema"
        DockPanel.Dock="Right"
        Width="105"
        SelectionChanged="ComboTema_SelectionChanged"
        VerticalContentAlignment="Center"
      >
        <ComboBoxItem Content="Sistema" />
        <ComboBoxItem Content="Claro" />
        <ComboBoxItem Content="Oscuro" />
      </ComboBox>
      <TextBlock DockPanel.Dock="Right" Text="Tema:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Button
        DockPanel.Dock="Right"
        Content="Administrar clasificaciones"
        Padding="8,4"
        Click="BtnAdministrarClasificaciones_Click"
      />
      <Button
        DockPanel.Dock="Right"
        Content="Carpetas observadas"
        Padding="8,4"
        Margin="0,0,8,0"
        Click="BtnCarpetasObservadas_Click"
      />
      <TextBlock FontSize="16" FontWeight="Bold" Text="Archivero" VerticalAlignment="Center" />
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <Button
          DockPanel.Dock="Right"
          Content="Cambiar…"
          Padding="8,2"
          Click="BtnCambiarCarpetaObservada_Click"
        />
        <StackPanel VerticalAlignment="Center">
          <TextBlock
            Name="TxtCarpetaObservada"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            TextWrapping="Wrap"
          />
          <TextBlock
            Name="TxtProgresoObservador"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
          />
        </StackPanel>
      </DockPanel>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="72" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
          <Button
            DockPanel.Dock="Right"
            Name="BtnMarcarAtendido"
            Content="Listo"
            Padding="8,2"
            Click="BtnMarcarAtendido_Click"
          />
          <TextBlock
            Name="TxtPorAtender"
            Text="Documentos pendientes de ingresar (0)"
            FontWeight="Bold"
            VerticalAlignment="Center"
          />
        </DockPanel>
        <ListBox
          Grid.Row="1"
          Name="ListaPorAtender"
          DisplayMemberPath="Resumen"
          MouseDoubleClick="ListaPorAtender_MouseDoubleClick"
          SelectionChanged="ListaPorAtender_SelectionChanged"
        />
      </Grid>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <!-- Caso-11, punto 3: red de seguridad manual; el reproceso ya corre solo al crear
                     o editar una configuración. -->
        <Button
          Name="BtnReprocesarPendientes"
          DockPanel.Dock="Right"
          Content="Reprocesar pendientes"
          Padding="8,2"
          Click="BtnReprocesarPendientes_Click"
          ToolTip="Vuelve a intentar reconocer todos los pendientes contra las configuraciones guardadas."
        />
        <TextBlock Text="Pendientes por reconocer" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox
        Grid.Row="1"
        Name="ListaPendientes"
        DisplayMemberPath="Texto"
        MouseDoubleClick="ListaPendientes_MouseDoubleClick"
      />
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Caso-4, punto 1: los PDF sin texto extraible tienen su propia lista, separada de
                 "Pendientes por reconocer": nunca aparecen mezclados con esa. -->
      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <!-- Caso-6, punto 1: refresco manual, además del arreglo de fondo; por si algo
                     puntual no se refleja solo, el usuario nunca depende de reabrir Archivero. -->
        <Button
          DockPanel.Dock="Right"
          Content="Recargar"
          Padding="8,2"
          Click="BtnRecargarPendientesDistribucion_Click"
        />
        <TextBlock Text="Pendientes de distribuir" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox
        Grid.Row="1"
        Name="ListaPendientesDistribucion"
        DisplayMemberPath="Texto"
        MouseDoubleClick="ListaPendientesDistribucion_MouseDoubleClick"
      />
    </Grid>

    <Grid Grid.Row="4" Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <Button
          DockPanel.Dock="Right"
          Content="Revisar ahora"
          Padding="8,2"
          Click="BtnRevisarObservadas_Click"
        />
        <TextBlock Text="Observados recientemente" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox
        Grid.Row="1"
        Name="ListaObservados"
        DisplayMemberPath="Resumen"
        MouseDoubleClick="ListaObservados_MouseDoubleClick"
        ToolTip="Si aparece «Buscar original», haz doble clic para abrir la carpeta del PDF."
      />
    </Grid>

    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock
        Grid.Row="0"
        Text="Guardados automáticamente (recientes)"
        FontWeight="Bold"
        Margin="0,0,0,8"
      />
      <ListBox
        Grid.Row="1"
        Name="ListaGuardados"
        DisplayMemberPath="Resumen"
        MouseDoubleClick="ListaGuardados_MouseDoubleClick"
      />
    </Grid>

    <!-- Caso-8: franja chica de estado con el tiempo humano ahorrado, total histórico
             acumulado (no una ventana de tiempo); no compite con las listas de arriba. -->
    <StackPanel Grid.Row="6" Margin="0,10,0,0">
      <TextBlock Name="TxtTiempoAhorrado" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock
        Name="TxtTiempoAhorradoAclaracion"
        FontSize="10"
        Foreground="{DynamicResource Hormiguero.TextoSecundario}"
        TextWrapping="Wrap"
      />
    </StackPanel>
  </Grid>
</Window>
