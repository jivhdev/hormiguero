<Window
  x:Class="Archivero.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Archivero"
  Icon="pack://application:,,,/Archivero;component/Recursos/icono.ico"
  Height="740"
  Width="860"
  WindowStartupLocation="CenterScreen"
>
  <Grid Margin="16">
    <Grid.Resources>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="130" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="90" />
      <RowDefinition Height="90" />
      <RowDefinition Height="90" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,4">
      <ComboBox
        Name="ComboTema"
        DockPanel.Dock="Right"
        Width="105"
        SelectionChanged="ComboTema_SelectionChanged"
        VerticalContentAlignment="Center"
      >
        <ComboBoxItem Content="Sistema" />
        <ComboBoxItem Content="Claro" />
        <ComboBoxItem Content="Oscuro" />
      </ComboBox>
      <TextBlock DockPanel.Dock="Right" Text="Tema:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Button
        DockPanel.Dock="Right"
        Content="Administrar clasificaciones"
        Padding="8,4"
        Click="BtnAdministrarClasificaciones_Click"
      />
      <Button
        DockPanel.Dock="Right"
        Content="Carpetas observadas"
        Padding="8,4"
        Margin="0,0,8,0"
        Click="BtnCarpetasObservadas_Click"
      />
      <TextBlock FontSize="16" FontWeight="Bold" Text="Archivero" VerticalAlignment="Center" />
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <Button
          DockPanel.Dock="Right"
          Content="Cambiar…"
          Padding="8,2"
          Click="BtnCambiarCarpetaObservada_Click"
        />
        <StackPanel VerticalAlignment="Center">
          <TextBlock
            Name="TxtCarpetaObservada"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            TextWrapping="Wrap"
          />
          <TextBlock
            Name="TxtProgresoObservador"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
          />
        </StackPanel>
      </DockPanel>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="72" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
          <Button
            DockPanel.Dock="Right"
            Name="BtnMarcarAtendido"
            Content="Listo"
            Padding="8,2"
            Click="BtnMarcarAtendido_Click"
          />
          <TextBlock
            Name="TxtPorAtender"
            Text="Documentos pendientes de ingresar (0)"
            FontWeight="Bold"
            VerticalAlignment="Center"
          />
        </DockPanel>
        <ListBox
          Grid.Row="1"
          Name="ListaPorAtender"
          DisplayMemberPath="Resumen"
          MouseDoubleClick="ListaPorAtender_MouseDoubleClick"
          SelectionChanged="ListaPorAtender_SelectionChanged"
        />
      </Grid>
    </Grid>

    <Grid Grid.Row="3" Name="SeccionDecisionesPendientes" Visibility="Collapsed" Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        Name="TxtDecisionesPendientes"
        Grid.Row="0"
        Text="Decisiones pendientes (0)"
        FontWeight="Bold"
        Margin="0,0,0,6"
      />
      <ListBox Grid.Row="1" Name="ListaDecisionesPendientes" MaxHeight="150">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock
                  Text="{Binding Etiqueta}"
                  FontSize="12"
                  FontWeight="Bold"
                  Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                />
                <TextBlock Text="{Binding Documento}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TipoProveedor}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Pregunta}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock
                  Text="{Binding Explicacion}"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                />
                <StackPanel
                  Orientation="Horizontal"
                  Visibility="{Binding MostrarCapturaDato, Converter={StaticResource BooleanToVisibilityConverter}}"
                >
                  <TextBlock Text="{Binding DatoPendiente}" VerticalAlignment="Center" />
                  <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <DatePicker
                    SelectedDate="{Binding FechaDato, UpdateSourceTrigger=PropertyChanged}"
                    Width="130"
                  />
                  <Button
                    Content="Guardar"
                    Padding="8,3"
                    Margin="6,0,0,0"
                    Click="BtnGuardarDatoCadena_Click"
                  />
                </StackPanel>
              </StackPanel>
              <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Visibility="{Binding MostrarAccionesOrigen, Converter={StaticResource BooleanToVisibilityConverter}}"
              >
                <Button
                  Content="Buscar el origen"
                  Padding="6,3"
                  Margin="2"
                  Click="BtnBuscarOrigen_Click"
                  ToolTip="Busca el número mencionado en Buscadero o lo copia para buscarlo."
                />
                <Button
                  Content="Crear la cadena igual"
                  Padding="6,3"
                  Margin="2"
                  Click="BtnCrearCadenaIgual_Click"
                  ToolTip="Crea una cadena nueva con este documento en su lugar."
                />
                <Button
                  Content="Solo archivar, sin cadena"
                  Padding="6,3"
                  Margin="2"
                  Click="BtnArchivarSinCadena_Click"
                  ToolTip="Cierra esta decisión y deja el documento archivado sin cadena."
                />
              </StackPanel>
              <ItemsControl
                Grid.Column="1"
                ItemsSource="{Binding OpcionesModo}"
                VerticalAlignment="Center"
                Visibility="{Binding MostrarOpcionesModo, Converter={StaticResource BooleanToVisibilityConverter}}"
              >
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button
                      Content="{Binding}"
                      Tag="{Binding}"
                      FontSize="16"
                      FontWeight="Bold"
                      MinWidth="110"
                      MinHeight="44"
                      Padding="12,8"
                      Margin="4"
                      Click="BtnFijarModo_Click"
                    />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <!-- Caso-11, punto 3: red de seguridad manual; el reproceso ya corre solo al crear
                     o editar una configuración. -->
        <Button
          Name="BtnReprocesarPendientes"
          DockPanel.Dock="Right"
          Content="Reprocesar pendientes"
          Padding="8,2"
          Click="BtnReprocesarPendientes_Click"
          ToolTip="Vuelve a intentar reconocer todos los pendientes contra las configuraciones guardadas."
        />
        <TextBlock Text="Pendientes por reconocer" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox
        Grid.Row="1"
        Name="ListaPendientes"
        DisplayMemberPath="Texto"
        MouseDoubleClick="ListaPendientes_MouseDoubleClick"
      />
    </Grid>

    <Grid Grid.Row="4" Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Caso-4, punto 1: los PDF sin texto extraible tienen su propia lista, separada de
                 "Pendientes por reconocer": nunca aparecen mezclados con esa. -->
      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <!-- Caso-6, punto 1: refresco manual, además del arreglo de fondo; por si algo
                     puntual no se refleja solo, el usuario nunca depende de reabrir Archivero. -->
        <Button
          DockPanel.Dock="Right"
          Content="Recargar"
          Padding="8,2"
          Click="BtnRecargarPendientesDistribucion_Click"
        />
        <TextBlock Text="Pendientes de distribuir" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox
        Grid.Row="1"
        Name="ListaPendientesDistribucion"
        DisplayMemberPath="Texto"
        MouseDoubleClick="ListaPendientesDistribucion_MouseDoubleClick"
      />
    </Grid>

    <Grid Grid.Row="5" Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <Button
          DockPanel.Dock="Right"
          Content="Revisar ahora"
          Padding="8,2"
          Click="BtnRevisarObservadas_Click"
        />
        <TextBlock Text="Observados recientemente" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox
        Grid.Row="1"
        Name="ListaObservados"
        DisplayMemberPath="Resumen"
        MouseDoubleClick="ListaObservados_MouseDoubleClick"
        ToolTip="Si aparece «Buscar original», haz doble clic para abrir la carpeta del PDF."
      />
    </Grid>

    <Grid Grid.Row="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock
        Grid.Row="0"
        Text="Guardados automáticamente (recientes)"
        FontWeight="Bold"
        Margin="0,0,0,8"
      />
      <ListBox
        Grid.Row="1"
        Name="ListaGuardados"
        DisplayMemberPath="Resumen"
        MouseDoubleClick="ListaGuardados_MouseDoubleClick"
      />
    </Grid>

    <!-- Caso-8: franja chica de estado con el tiempo humano ahorrado, total histórico
             acumulado (no una ventana de tiempo); no compite con las listas de arriba. -->
    <StackPanel Grid.Row="7" Margin="0,10,0,0">
      <TextBlock Name="TxtTiempoAhorrado" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock
        Name="TxtTiempoAhorradoAclaracion"
        FontSize="10"
        Foreground="{DynamicResource Hormiguero.TextoSecundario}"
        TextWrapping="Wrap"
      />
    </StackPanel>
  </Grid>
</Window>
