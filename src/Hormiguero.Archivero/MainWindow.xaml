<Window x:Class="Archivero.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivero" Height="700" Width="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Administrar clasificaciones" Padding="8,4" Click="BtnAdministrarClasificaciones_Click"/>
            <TextBlock FontSize="16" FontWeight="Bold" Text="Archivero" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Cambiar…" Padding="8,2" Click="BtnCambiarCarpetaObservada_Click"/>
            <TextBlock Name="TxtCarpetaObservada" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <!-- Caso-11, punto 3: red de seguridad manual; el reproceso ya corre solo al crear
                     o editar una configuración. -->
                <Button Name="BtnReprocesarPendientes" DockPanel.Dock="Right" Content="Reprocesar pendientes" Padding="8,2"
                        Click="BtnReprocesarPendientes_Click"
                        ToolTip="Vuelve a intentar reconocer todos los pendientes contra las configuraciones guardadas."/>
                <TextBlock Text="Pendientes por reconocer" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox Grid.Row="1" Name="ListaPendientes" DisplayMemberPath="Texto" MouseDoubleClick="ListaPendientes_MouseDoubleClick"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Caso-4, punto 1: los PDF sin texto extraible tienen su propia lista, separada de
                 "Pendientes por reconocer": nunca aparecen mezclados con esa. -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <!-- Caso-6, punto 1: refresco manual, además del arreglo de fondo; por si algo
                     puntual no se refleja solo, el usuario nunca depende de reabrir Archivero. -->
                <Button DockPanel.Dock="Right" Content="Recargar" Padding="8,2" Click="BtnRecargarPendientesDistribucion_Click"/>
                <TextBlock Text="Pendientes de distribuir" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox Grid.Row="1" Name="ListaPendientesDistribucion" DisplayMemberPath="Texto" MouseDoubleClick="ListaPendientesDistribucion_MouseDoubleClick"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Guardados automáticamente (recientes)" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" Name="ListaGuardados" DisplayMemberPath="Resumen" MouseDoubleClick="ListaGuardados_MouseDoubleClick"/>
        </Grid>

        <!-- Caso-8: franja chica de estado con el tiempo humano ahorrado, total histórico
             acumulado (no una ventana de tiempo); no compite con las listas de arriba. -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Name="TxtTiempoAhorrado" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Name="TxtTiempoAhorradoAclaracion" FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
