<Window
  x:Class="Hormiguero.Archivero.VentanaConfiguraciones"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Configuraciones"
  Width="900"
  Height="640"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Hormiguero.Fondo}"
>
  <Grid Margin="{DynamicResource Hormiguero.Margen}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Text="Cada configuración le enseña a Archivero a reconocer un tipo de documento de un emisor. Cambiarla no mueve los documentos que ya están guardados."
      FontSize="{DynamicResource Hormiguero.TextoNormal}"
      Foreground="{DynamicResource Hormiguero.TextoSecundario}"
      TextWrapping="Wrap"
      Margin="0,0,0,12"
    />

    <!-- Lista agrupada por emisor. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock
          x:Name="SinConfiguraciones"
          Text="Todavía no hay configuraciones. Aparecen al identificar el primer documento."
          FontSize="{DynamicResource Hormiguero.TextoNormal}"
          Foreground="{DynamicResource Hormiguero.TextoSecundario}"
          TextWrapping="Wrap"
        />
        <ItemsControl x:Name="ListaGrupos">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock
                  Text="{Binding Emisor}"
                  FontSize="{DynamicResource Hormiguero.TextoTitulo}"
                  Foreground="{DynamicResource Hormiguero.Texto}"
                  Margin="0,12,0,4"
                />
                <ItemsControl ItemsSource="{Binding Filas}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                        Background="{DynamicResource Hormiguero.Superficie}"
                        BorderBrush="{DynamicResource Hormiguero.Borde}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Hormiguero.Radio}"
                        Padding="{DynamicResource Hormiguero.Margen}"
                        Margin="0,4"
                      >
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock
                              Text="{Binding Tipo}"
                              FontSize="{DynamicResource Hormiguero.TextoTitulo}"
                              Foreground="{DynamicResource Hormiguero.Texto}"
                              TextWrapping="Wrap"
                            />
                            <TextBlock
                              Text="{Binding TextoDestino}"
                              FontSize="{DynamicResource Hormiguero.TextoNormal}"
                              Foreground="{Binding ColorDestino}"
                              TextWrapping="Wrap"
                            />
                          </StackPanel>
                          <Button
                            Grid.Column="1"
                            Content="Editar"
                            FontSize="{DynamicResource Hormiguero.TextoNormal}"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Tag="{Binding}"
                            Visibility="{Binding VisibilidadBotonEditar}"
                            Click="Editar_Click"
                          />
                          <Button
                            Grid.Column="2"
                            Content="Quitar"
                            FontSize="{DynamicResource Hormiguero.TextoNormal}"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Tag="{Binding}"
                            Click="Quitar_Click"
                          />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Button
      x:Name="BtnCerrar"
      Grid.Row="2"
      Content="Cerrar"
      FontSize="{DynamicResource Hormiguero.TextoNormal}"
      Padding="16,8"
      HorizontalAlignment="Right"
      Margin="0,12,0,0"
      Click="Cerrar_Click"
    />
  </Grid>
</Window>
