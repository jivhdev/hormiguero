<Window
  x:Class="Hormiguero.Mensajero.App.VentanaFacturas"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="ClickFactura - Envío Semanal de Facturas"
  Background="{DynamicResource Hormiguero.Superficie}"
  Foreground="{DynamicResource Hormiguero.Texto}"
  Width="950"
  Height="700"
  MinWidth="760"
  MinHeight="520"
  WindowStartupLocation="CenterScreen"
  PreviewKeyDown="Ventana_PreviewKeyDown"
>
  <Grid Margin="16">
    <Grid x:Name="PaginaPeriodo">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        Text="📅 Configurar Período"
        FontSize="22"
        FontWeight="Bold"
        HorizontalAlignment="Center"
        Margin="0,8,0,18"
      />
      <StackPanel
        Grid.Row="1"
        VerticalAlignment="Center"
        MaxWidth="700"
        HorizontalAlignment="Center"
      >
        <GroupBox Header="Semana principal" Padding="12" Margin="0,0,0,10">
          <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="N° de semana:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="SemanaUno" Width="70" Margin="0,0,18,0" />
            <TextBlock Text="Mes:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="MesUno" Width="145" Margin="0,0,18,0" />
            <TextBlock Text="Año:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="AnioUno" Width="90" />
          </WrapPanel>
        </GroupBox>
        <CheckBox
          x:Name="IncluyeSegunda"
          Content="El período abarca dos meses"
          Margin="0,4,0,10"
          Checked="SegundaSemana_Changed"
          Unchecked="SegundaSemana_Changed"
        />
        <GroupBox
          x:Name="GrupoSegunda"
          Header="Segunda semana"
          Padding="12"
          Margin="0,0,0,10"
          Visibility="Collapsed"
        >
          <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="N° de semana:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="SemanaDos" Width="70" Margin="0,0,18,0" />
            <TextBlock Text="Mes:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="MesDos" Width="145" Margin="0,0,18,0" />
            <TextBlock Text="Año:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="AnioDos" Width="90" />
          </WrapPanel>
        </GroupBox>
        <CheckBox
          x:Name="BusquedaAmpliada"
          Content="🔍 Buscar en todas las carpetas (modo búsqueda ampliada)"
          Margin="0,8,0,16"
        />
        <Button
          Content="👁️ Vista previa"
          Click="VistaPrevia_Click"
          HorizontalAlignment="Center"
          Padding="18,7"
        />
        <TextBlock
          x:Name="TextoVistaPrevia"
          TextWrapping="Wrap"
          TextAlignment="Center"
          Margin="0,10"
          Foreground="{DynamicResource Hormiguero.Texto}"
        />
      </StackPanel>
      <GroupBox Grid.Row="2" Header="Carpetas" Padding="8" Margin="0,4,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Text="Carpeta principal de documentos (la que contiene las carpetas FCV y NCV):"
            VerticalAlignment="Center"
            Margin="0,0,8,4"
          />
          <StackPanel Grid.Column="1" Margin="0,0,8,4">
            <TextBlock x:Name="TextoCarpetaDocumentos" TextWrapping="Wrap" />
            <TextBlock
              x:Name="TextoEstadoDocumentos"
              Text="No se encuentra esta carpeta"
              Foreground="{DynamicResource Hormiguero.Error}"
            />
          </StackPanel>
          <Button
            Grid.Column="2"
            Content="Cambiar…"
            Click="CambiarCarpetaDocumentos_Click"
            Margin="0,0,0,4"
          />
          <TextBlock
            Grid.Row="1"
            Text="Carpeta temporal para envíos:"
            VerticalAlignment="Center"
            Margin="0,0,8,0"
          />
          <TextBlock
            x:Name="TextoCarpetaTemporal"
            Grid.Row="1"
            Grid.Column="1"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            Margin="0,0,8,0"
          />
          <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
            <Button Content="Cambiar…" Click="CambiarCarpetaTemporal_Click" Margin="0,0,6,0" />
            <Button Content="Abrir" Click="AbrirCarpetaTemporal_Click" />
          </StackPanel>
        </Grid>
      </GroupBox>
      <Button
        Grid.Row="3"
        Content="Siguiente →"
        Click="SiguientePeriodo_Click"
        HorizontalAlignment="Right"
        Padding="18,8"
      />
    </Grid>
    <Grid x:Name="PaginaCarga" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        Text="📂 Cargar Archivo XLS"
        FontSize="22"
        FontWeight="Bold"
        HorizontalAlignment="Center"
        Margin="0,8,0,18"
      />
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock
          x:Name="TextoArchivoXls"
          Text="Ningún archivo seleccionado"
          TextWrapping="Wrap"
          MaxWidth="700"
          HorizontalAlignment="Center"
          Margin="0,0,0,16"
        />
        <Button
          Content="📁 Seleccionar Archivo XLS"
          Click="SeleccionarXls_Click"
          Padding="18,12"
          HorizontalAlignment="Center"
        />
      </StackPanel>
      <DockPanel Grid.Row="2">
        <Button
          Content="← Atrás"
          Click="AtrasPeriodo_Click"
          HorizontalAlignment="Left"
          Padding="18,8"
        />
        <Button
          x:Name="BotonAnalizar"
          Content="Analizar →"
          Click="Analizar_Click"
          IsEnabled="False"
          HorizontalAlignment="Right"
          Padding="18,8"
        />
      </DockPanel>
    </Grid>
    <Grid x:Name="PaginaAnalisis" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel>
        <Button
          DockPanel.Dock="Right"
          Content="📋 Gestionar Clientes"
          Click="GestionarClientes_Click"
        />
        <TextBlock
          Text="🔍 Análisis de Documentos"
          FontSize="22"
          FontWeight="Bold"
          VerticalAlignment="Center"
        />
      </DockPanel>
      <TextBlock
        x:Name="EstadoAnalisis"
        Grid.Row="1"
        Text=""
        HorizontalAlignment="Center"
        Margin="0,8"
      />
      <DataGrid
        x:Name="TablaAnalisis"
        Grid.Row="2"
        IsReadOnly="True"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        HeadersVisibility="Column"
      >
        <DataGrid.Columns>
          <DataGridTextColumn Header="RUT" Binding="{Binding Rut}" />
          <DataGridTextColumn Header="Cliente" Binding="{Binding RazonSocial}" Width="*" />
          <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="*" />
          <DataGridTextColumn Header="Docs" Binding="{Binding CantidadDocumentos}" />
          <DataGridTextColumn Header="PDFs encontrados" Binding="{Binding CantidadEncontrados}" />
          <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Row="3" Margin="0,10,0,0">
        <Button Content="← Atrás" Click="AtrasCarga_Click" Padding="18,8" />
        <Button
          x:Name="BotonIrEnvios"
          Content="Ir a Envíos →"
          Click="IrEnvios_Click"
          IsEnabled="False"
          HorizontalAlignment="Right"
          Padding="18,8"
        />
      </DockPanel>
    </Grid>
    <Grid x:Name="PaginaEnvio" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1.2*" />
        <RowDefinition Height="1.8*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        Text="📧 Preparar Envíos"
        FontSize="22"
        FontWeight="Bold"
        HorizontalAlignment="Center"
      />
      <StackPanel Grid.Row="1" Margin="0,8">
        <TextBlock x:Name="TextoClienteActual" FontSize="16" FontWeight="Bold" />
        <DockPanel Margin="0,4,0,6">
          <TextBlock x:Name="TextoConteoEstados" VerticalAlignment="Center" />
          <ComboBox
            x:Name="FiltroEnvios"
            Width="165"
            Margin="12,0,0,0"
            SelectionChanged="FiltroEnvios_Changed"
          />
        </DockPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="📋 Copiar correo" Click="CopiarCorreo_Click" />
          <TextBlock Text="Correo (Alt+A):" VerticalAlignment="Top" Margin="0,0,8,0" />
          <TextBlock x:Name="TextoCorreo" FontWeight="Bold" TextWrapping="Wrap" />
        </DockPanel>
      </StackPanel>
      <DataGrid
        x:Name="TablaDocumentos"
        Grid.Row="2"
        IsReadOnly="True"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        HeadersVisibility="Column"
        Margin="0,4"
      >
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" />
          <DataGridTextColumn Header="Número" Binding="{Binding Numero}" />
          <DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      <GroupBox Grid.Row="3" Header="Mensaje del correo" Padding="8" Margin="0,5">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="📋 Copiar asunto" Click="CopiarAsunto_Click" />
            <TextBlock Text="Asunto: (Alt+S)" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox x:Name="CampoAsunto" Grid.Row="1" MinHeight="32" TextWrapping="Wrap" />
          <DockPanel Grid.Row="2" Margin="0,5,0,0">
            <Button DockPanel.Dock="Right" Content="📋 Copiar cuerpo" Click="CopiarCuerpo_Click" />
            <TextBlock Text="Cuerpo: (Alt+D)" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox
            x:Name="CampoCuerpo"
            Grid.Row="3"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
          />
        </Grid>
      </GroupBox>
      <StackPanel Grid.Row="4" Margin="0,5">
        <WrapPanel HorizontalAlignment="Center">
          <Button
            x:Name="BotonPreparar"
            Content="📋 Preparar Envío (Alt+F)"
            Click="PrepararEnvio_Click"
            Margin="3"
            Padding="10,7"
          />
          <Button
            x:Name="BotonPendiente"
            Content="⏳ Dejar Pendiente"
            Click="Pendiente_Click"
            Margin="3"
            Padding="10,7"
          />
          <Button
            x:Name="BotonEnviado"
            Content="✅ Marcar como Enviado"
            Click="Enviado_Click"
            IsEnabled="False"
            Margin="3"
            Padding="10,7"
          />
        </WrapPanel>
        <TextBlock
          Text="Copia los PDF de este cliente a una carpeta y los deja listos para pegar en el correo (Ctrl+V)."
          TextWrapping="Wrap"
          TextAlignment="Center"
          Foreground="{DynamicResource Hormiguero.TextoSecundario}"
          Margin="0,2,0,0"
        />
      </StackPanel>
      <DockPanel Grid.Row="5" Margin="0,6,0,0">
        <Button Content="← Volver al análisis" Click="VolverAnalisis_Click" Padding="12,6" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
