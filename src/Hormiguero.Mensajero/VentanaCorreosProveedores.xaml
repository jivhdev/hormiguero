<Window
  x:Class="Hormiguero.Mensajero.App.VentanaCorreosProveedores"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Correos de proveedores"
  Width="650"
  Height="520"
  MinWidth="520"
  MinHeight="420"
  WindowStartupLocation="CenterOwner"
>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Proveedor y correos asociados" FontSize="17" FontWeight="Bold" />
    <StackPanel Grid.Row="1" Margin="0,10,0,8">
      <TextBlock Text="Proveedor" />
      <TextBox x:Name="CampoProveedor" Margin="0,2,0,6" />
      <TextBlock Text="Correos (separados por punto y coma, coma o espacio)" />
      <TextBox x:Name="CampoCorreos" Margin="0,2,0,0" />
    </StackPanel>
    <ListBox
      x:Name="ListaProveedores"
      Grid.Row="2"
      SelectionChanged="ListaProveedores_SelectionChanged"
    >
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="3">
            <TextBlock Text="{Binding Proveedor}" FontWeight="Bold" />
            <TextBlock
              Text="{Binding Correos}"
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="TextoAviso" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" />
    <WrapPanel Grid.Row="4" Margin="0,10,0,0">
      <Button Content="Guardar" Click="Guardar_Click" Margin="0,0,6,0" />
      <Button Content="Quitar" Click="Quitar_Click" Margin="0,0,6,0" />
      <Button Content="Nuevo" Click="Nuevo_Click" />
    </WrapPanel>
  </Grid>
</Window>
