<Window
  x:Class="Hormiguero.Mensajero.App.VentanaClientesFactura"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="ClickFactura - Gestión de Clientes"
  Background="{DynamicResource Hormiguero.Superficie}"
  Foreground="{DynamicResource Hormiguero.Texto}"
  Width="850"
  Height="620"
  MinWidth="700"
  MinHeight="500"
  WindowStartupLocation="CenterOwner"
>
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.1*" />
      <ColumnDefinition Width="1.5*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Button
        DockPanel.Dock="Right"
        Content="Importar de ClickFactura…"
        Click="ImportarClientesFactura_Click"
      />
      <TextBlock
        Text="Clientes de Facturas"
        FontSize="18"
        FontWeight="Bold"
        VerticalAlignment="Center"
      />
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,12,0">
      <TextBox
        DockPanel.Dock="Top"
        x:Name="CampoBuscar"
        Margin="0,0,0,8"
        ToolTip="Buscar por RUT o razón social"
        TextChanged="Buscar_TextChanged"
      />
      <ListBox
        x:Name="ListaClientes"
        DisplayMemberPath="RazonSocial"
        SelectionChanged="Cliente_Seleccionado"
      />
    </DockPanel>
    <StackPanel Grid.Column="1" Grid.Row="1">
      <TextBlock Text="RUT" />
      <TextBox x:Name="CampoRut" Margin="0,2,0,8" />
      <TextBlock Text="Razón social" />
      <TextBox x:Name="CampoRazon" Margin="0,2,0,8" />
      <CheckBox x:Name="CampoActivo" Content="Cliente activo" Margin="0,0,0,8" />
      <TextBlock Text="Correos" />
      <ListBox x:Name="ListaCorreos" Height="150" Margin="0,2,0,6" />
      <DockPanel Margin="0,0,0,8">
        <Button
          DockPanel.Dock="Right"
          Content="Agregar correo"
          Click="AgregarCorreo_Click"
          Margin="8,0,0,0"
        />
        <TextBox x:Name="CampoCorreo" ToolTip="correo@empresa.cl" />
      </DockPanel>
      <Button
        Content="Quitar correo"
        Click="QuitarCorreo_Click"
        HorizontalAlignment="Left"
        Margin="0,0,0,10"
      />
      <WrapPanel>
        <Button Content="Nuevo cliente" Click="NuevoCliente_Click" Margin="0,0,6,6" />
        <Button Content="Eliminar cliente" Click="EliminarCliente_Click" Margin="0,0,6,6" />
      </WrapPanel>
      <TextBlock
        x:Name="TextoAviso"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Hormiguero.Aviso}"
      />
    </StackPanel>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Guardar" Click="Guardar_Click" Padding="18,6" />
      <Button Content="Cerrar" Click="Cerrar_Click" Padding="18,6" />
    </DockPanel>
  </Grid>
</Window>
