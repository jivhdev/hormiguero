<Window
  x:Class="Hormiguero.Mensajero.App.VentanaPlantillas"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Plantillas de mensajes"
  Width="1050"
  Height="720"
  MinWidth="820"
  MinHeight="600"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Hormiguero.Superficie}"
  Foreground="{DynamicResource Hormiguero.Texto}"
  ResizeMode="CanResize"
>
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock
      Grid.ColumnSpan="3"
      Text="Plantillas de mensajes"
      FontSize="20"
      FontWeight="Bold"
      Margin="0,0,0,14"
    />
    <ListBox x:Name="ListaPlantillas" Grid.Row="1" />
    <Grid Grid.Row="1" Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="Texto de la plantilla" FontWeight="Bold" Margin="0,0,0,5" />
      <TextBox
        x:Name="CampoTexto"
        Grid.Row="1"
        AcceptsReturn="True"
        AcceptsTab="True"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto"
        FontFamily="Consolas"
        FontSize="13"
        Background="{DynamicResource Hormiguero.Superficie}"
      />
      <TextBlock Grid.Row="2" Text="Marcadores disponibles" FontWeight="Bold" Margin="0,12,0,4" />
      <ItemsControl x:Name="ListaMarcadores" Grid.Row="3" />
      <StackPanel Grid.Row="4" Margin="0,12,0,0">
        <TextBlock Text="Vista previa con datos de ejemplo" FontWeight="Bold" Margin="0,0,0,5" />
        <TextBox
          x:Name="CampoVistaPrevia"
          IsReadOnly="True"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
          FontFamily="Consolas"
          Background="{DynamicResource Hormiguero.Superficie}"
        />
      </StackPanel>
    </Grid>
    <StackPanel
      Grid.Row="2"
      Grid.ColumnSpan="3"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,14,0,0"
    >
      <Button
        x:Name="BotonGuardar"
        Content="Guardar"
        MinWidth="90"
        Padding="12,6"
        Margin="0,0,8,0"
      />
      <Button
        x:Name="BotonPredeterminado"
        Content="Volver al texto predeterminado"
        Padding="12,6"
        Margin="0,0,8,0"
      />
      <Button x:Name="BotonCerrar" Content="Cerrar" MinWidth="90" Padding="12,6" />
    </StackPanel>
  </Grid>
</Window>
