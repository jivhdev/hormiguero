<Window
  x:Class="Buscadero.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:Buscadero.App"
  mc:Ignorable="d"
  Title="Buscadero"
  Icon="pack://application:,,,/Buscadero;component/Recursos/icono.ico"
  Height="768"
  Width="1366"
  MinHeight="650"
  MinWidth="1000"
  PreviewMouseLeftButtonUp="Ventana_PreviewMouseLeftButtonUp"
  PreviewKeyDown="Ventana_PreviewKeyDown"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,6,8,0">
      <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox
        x:Name="ComboTema"
        Width="105"
        SelectionChanged="ComboTema_SelectionChanged"
        VerticalContentAlignment="Center"
      >
        <ComboBoxItem Content="Sistema" />
        <ComboBoxItem Content="Claro" />
        <ComboBoxItem Content="Oscuro" />
      </ComboBox>
    </StackPanel>
    <TabControl x:Name="Pestanas" Grid.Row="1" Margin="8">
      <TabItem Header="Documento">
        <DockPanel Margin="8">
          <StackPanel
            DockPanel.Dock="Top"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,0,0,6"
          >
            <Button
              x:Name="BotonSegundaBusqueda"
              Content="Segunda búsqueda"
              Padding="8,4"
              Click="BotonSegundaBusqueda_Click"
            />
            <Button
              x:Name="BotonCerrarSegundaBusqueda"
              Content="Cerrar segunda búsqueda"
              Padding="8,4"
              Margin="6,0,0,0"
              Visibility="Collapsed"
              Click="BotonCerrarSegundaBusqueda_Click"
            />
          </StackPanel>
          <Grid x:Name="ContenedorPanelesDocumento">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition x:Name="ColumnaPanelSecundario" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0" Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock
                  Text="Número de documento:"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0"
                />
                <TextBox
                  x:Name="TextoNumero"
                  Width="200"
                  Margin="0,0,16,0"
                  VerticalContentAlignment="Center"
                  KeyDown="TextoNumero_KeyDown"
                />
                <TextBlock Text="Alcance:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox
                  x:Name="ComboAlcance"
                  Width="170"
                  Margin="0,0,16,0"
                  SelectedIndex="0"
                  VerticalContentAlignment="Center"
                  SelectionChanged="ComboAlcance_SelectionChanged"
                  ToolTip="En qué carpetas buscar — se decide primero porque condiciona los demás controles"
                >
                  <ComboBoxItem Content="Primera coincidencia" />
                  <ComboBoxItem Content="Todas las carpetas" />
                  <ComboBoxItem Content="Carpeta específica" />
                </ComboBox>
                <TextBlock Text="Carpeta:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox
                  x:Name="ComboFiltroCarpeta"
                  Width="280"
                  Margin="0,0,16,0"
                  IsEditable="True"
                  IsEnabled="False"
                  VerticalContentAlignment="Center"
                  IsTextSearchEnabled="False"
                  DisplayMemberPath="Texto"
                  DropDownOpened="ComboFiltroCarpeta_DropDownOpened"
                  TextBoxBase.TextChanged="ComboFiltroCarpeta_TextChanged"
                  ToolTip="Solo se usa con el alcance 'Carpeta específica'; escriba 3 o más letras para buscar por nombre"
                />
                <TextBlock Text="Modo:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox
                  x:Name="ComboModo"
                  Width="150"
                  Margin="0,0,16,0"
                  SelectedIndex="0"
                  VerticalContentAlignment="Center"
                  ToolTip="Todos prueba las estrategias en orden; también puede forzar una"
                >
                  <ComboBoxItem Content="Todos" />
                  <ComboBoxItem Content="Exacto" />
                  <ComboBoxItem Content="Alfanumérico" />
                  <ComboBoxItem Content="Solo número" />
                  <ComboBoxItem Content="Solo letras" />
                </ComboBox>
                <Button
                  x:Name="BotonBuscar"
                  Content="Buscar"
                  Padding="10,4"
                  Click="BotonBuscar_Click"
                />
              </WrapPanel>

              <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <ProgressBar
                  x:Name="BarraProgreso"
                  Height="6"
                  IsIndeterminate="True"
                  Visibility="Collapsed"
                />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock
                    x:Name="TextoEstadoBusqueda"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                  />
                  <Button
                    x:Name="BotonCancelarBusqueda"
                    Content="Cancelar búsqueda"
                    Padding="6,2"
                    Margin="12,0,0,0"
                    Visibility="Collapsed"
                    Click="BotonCancelarBusqueda_Click"
                  />
                </StackPanel>
                <StackPanel
                  x:Name="PanelSinResultados"
                  Orientation="Horizontal"
                  Visibility="Collapsed"
                  Margin="0,6,0,0"
                >
                  <Button
                    Content="Agregar carpeta"
                    Padding="8,4"
                    Margin="0,0,8,0"
                    Click="BotonIrACarpetas_Click"
                  />
                  <Button
                    Content="Modificar número"
                    Padding="8,4"
                    Click="BotonModificarNumero_Click"
                  />
                </StackPanel>
                <ListView
                  x:Name="ListaResultados"
                  Height="110"
                  Margin="0,6,0,0"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  MouseDoubleClick="ListaResultados_MouseDoubleClick"
                >
                  <ListView.View>
                    <GridView>
                      <GridViewColumn
                        Header="Carpeta"
                        Width="380"
                        DisplayMemberBinding="{Binding Carpeta}"
                      />
                      <GridViewColumn
                        Header="Archivo"
                        Width="260"
                        DisplayMemberBinding="{Binding Nombre}"
                      />
                      <GridViewColumn
                        Header="Modificado"
                        Width="150"
                        DisplayMemberBinding="{Binding Modificado}"
                      />
                    </GridView>
                  </ListView.View>
                </ListView>
              </StackPanel>

              <StackPanel
                Grid.Row="2"
                x:Name="BarraVisor"
                Orientation="Horizontal"
                Visibility="Collapsed"
                Margin="0,0,0,6"
              >
                <TextBlock
                  x:Name="TextoDocumentoAbierto"
                  FontWeight="Bold"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  MaxWidth="260"
                  TextTrimming="CharacterEllipsis"
                />
                <Button
                  x:Name="BotonVerEnCarpeta"
                  Content="Ver en carpeta"
                  Padding="8,4"
                  Margin="0,0,16,0"
                  Click="BotonVerEnCarpeta_Click"
                  ToolTip="Abrir el Explorador de Windows en la carpeta del documento, con el archivo seleccionado"
                />
                <Button
                  x:Name="BotonImprimir"
                  Content="Imprimir ▾"
                  Padding="8,4"
                  Margin="0,0,10,0"
                  IsEnabled="False"
                  Click="BotonImprimir_Click"
                >
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem
                        Header="Primera página"
                        Tag="PrimeraPagina"
                        Click="OpcionImprimir_Click"
                      />
                      <MenuItem
                        Header="Primeras 2 páginas"
                        Tag="PrimerasDosPaginas"
                        Click="OpcionImprimir_Click"
                      />
                      <MenuItem
                        Header="Todo el documento"
                        Tag="DocumentoCompleto"
                        Click="OpcionImprimir_Click"
                      />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
                <TextBlock
                  x:Name="TextoAvisoImpresion"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                />
                <Button
                  x:Name="BotonAbrirEnVisor"
                  Content="Abrir en el visor"
                  Padding="8,4"
                  Margin="0,0,6,0"
                  IsEnabled="False"
                  Click="BotonAbrirEnVisor_Click"
                />
                <Button
                  x:Name="BotonCopiarPdf"
                  Content="Copiar PDF"
                  Padding="8,4"
                  Margin="0,0,10,0"
                  IsEnabled="False"
                  Click="BotonCopiarPdf_Click"
                />
                <Button
                  x:Name="BotonPaginaAnterior"
                  Content="Anterior"
                  Padding="8,4"
                  Margin="0,0,6,0"
                  Click="BotonPaginaAnterior_Click"
                />
                <TextBlock x:Name="TextoPagina" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button
                  x:Name="BotonPaginaSiguiente"
                  Content="Siguiente"
                  Padding="8,4"
                  Margin="0,0,16,0"
                  Click="BotonPaginaSiguiente_Click"
                />
                <Button
                  x:Name="BotonAlejar"
                  Content="Alejar"
                  Padding="8,4"
                  Margin="0,0,6,0"
                  Click="BotonAlejar_Click"
                />
                <Button
                  x:Name="BotonAcercar"
                  Content="Acercar"
                  Padding="8,4"
                  Margin="0,0,6,0"
                  Click="BotonAcercar_Click"
                />
                <TextBlock x:Name="TextoZoom" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button
                  x:Name="BotonAjustar"
                  Content="Ajustar"
                  Padding="8,4"
                  Click="BotonAjustar_Click"
                />
                <Button
                  x:Name="BotonComparar"
                  Content="Comparar"
                  Padding="8,4"
                  Margin="16,0,0,0"
                  Click="BotonComparar_Click"
                  ToolTip="Comparar el documento observado con otro, lado a lado"
                />
              </StackPanel>
              <WrapPanel Grid.Row="3" x:Name="BarraMarcas" Visibility="Collapsed" Margin="0,0,0,6">
                <ToggleButton
                  x:Name="BotonModoMarcas"
                  Content="Modo marcas"
                  Padding="8,4"
                  Margin="0,0,6,0"
                  Click="BotonModoMarcas_Click"
                  ToolTip="Mientras esté activo, un clic sobre el documento coloca la marca elegida"
                />
                <ToggleButton
                  x:Name="BotonModoSeleccionarTexto"
                  Content="Modo seleccionar texto"
                  Padding="8,4"
                  Margin="0,0,16,0"
                  Click="BotonModoSeleccionarTexto_Click"
                  ToolTip="Arrastre sobre el PDF para seleccionar palabras y luego cópielas"
                />
                <Button
                  x:Name="BotonCopiarTextoSeleccionado"
                  Content="Copiar texto seleccionado"
                  Padding="8,4"
                  Margin="0,0,8,0"
                  IsEnabled="False"
                  Click="BotonCopiarTextoSeleccionado_Click"
                />
                <TextBlock
                  Text="Marcas:"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0"
                  FontWeight="Bold"
                />
                <ComboBox
                  x:Name="ComboHerramienta"
                  Width="130"
                  Margin="0,0,12,0"
                  SelectedIndex="0"
                  VerticalContentAlignment="Center"
                  SelectionChanged="ComboHerramienta_SelectionChanged"
                  ToolTip="Elija una herramienta y haga clic o arrastre sobre el documento"
                >
                  <ComboBoxItem Content="Tick" />
                  <ComboBoxItem Content="X" />
                  <ComboBoxItem Content="Raya" />
                  <ComboBoxItem Content="Círculo" />
                  <ComboBoxItem Content="Texto" />
                </ComboBox>
                <CheckBox
                  x:Name="CheckMostrarMarcas"
                  Content="Mostrar marcas"
                  IsChecked="True"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0"
                  Click="CheckMostrarMarcas_Click"
                />
                <Button
                  x:Name="BotonDeshacer"
                  Content="Deshacer"
                  Padding="8,4"
                  Margin="0,0,6,0"
                  Click="BotonDeshacer_Click"
                />
                <Button
                  x:Name="BotonRehacer"
                  Content="Rehacer"
                  Padding="8,4"
                  Margin="0,0,12,0"
                  Click="BotonRehacer_Click"
                />
                <Button
                  x:Name="BotonBorrarMarcas"
                  Content="Borrar marcas"
                  Padding="8,4"
                  Click="BotonBorrarMarcas_Click"
                />
              </WrapPanel>

              <Border
                Grid.Row="5"
                BorderBrush="{DynamicResource Hormiguero.Borde}"
                BorderThickness="1"
                Background="{DynamicResource Hormiguero.Encabezado}"
              >
                <Grid>
                  <ScrollViewer
                    x:Name="LienzoVisor"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    PreviewMouseWheel="LienzoVisor_PreviewMouseWheel"
                  >
                    <Grid
                      x:Name="ContenedorPagina"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                    >
                      <Image
                        x:Name="ImagenPdf"
                        Stretch="None"
                        RenderOptions.BitmapScalingMode="HighQuality"
                      />
                      <Canvas
                        x:Name="CanvasMarcas"
                        Background="Transparent"
                        MouseLeftButtonDown="CanvasMarcas_MouseLeftButtonDown"
                        MouseMove="CanvasMarcas_MouseMove"
                      />
                    </Grid>
                  </ScrollViewer>
                  <TextBlock
                    x:Name="TextoVisorVacio"
                    Text="Busque un documento para visualizarlo."
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                  />
                </Grid>
              </Border>
            </Grid>
            <GridSplitter
              x:Name="SeparadorPaneles"
              Grid.Column="0"
              Width="5"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Visibility="Collapsed"
              Background="{DynamicResource Hormiguero.Borde}"
            />
            <local:PanelBusquedaSecundario
              x:Name="PanelBusquedaSecundario"
              Grid.Column="1"
              Margin="8,0,0,0"
              Visibility="Collapsed"
            />
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Cadenas documentales">
        <StackPanel Margin="8" VerticalAlignment="Top">
          <TextBlock Text="Cadenas documentales" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
          <TextBlock
            Text="Cree cadenas con documentos guardados y consulte las coincidencias sugeridas."
            TextWrapping="Wrap"
            MaxWidth="600"
            Margin="0,0,0,8"
          />
          <Button
            Content="Administrar cadenas"
            Padding="14,10"
            HorizontalAlignment="Left"
            Click="BotonCadenasSimples_Click"
          />
          <TextBlock
            Text="Las cadenas reúnen documentos relacionados y mantienen un historial de sus cambios."
            TextWrapping="Wrap"
            MaxWidth="560"
            Margin="0,0,0,12"
          />
          <Button
            x:Name="BotonDudosos"
            Content="0 dudosos"
            Padding="14,10"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            Click="BotonDudosos_Click"
          />
          <Button
            x:Name="BotonAlertas"
            Content="0 alertas"
            Padding="14,10"
            Margin="8,10,0,0"
            HorizontalAlignment="Left"
            Click="BotonAlertas_Click"
          />
          <Button
            Content="Calcular fecha"
            Padding="10,7"
            Margin="0,8,8,0"
            HorizontalAlignment="Left"
            Click="BotonCalcularFecha_Click"
          />
          <Button
            Content="Feriados"
            Padding="10,7"
            Margin="0,8,8,0"
            HorizontalAlignment="Left"
            Click="BotonFeriados_Click"
          />
        </StackPanel>
      </TabItem>

      <TabItem Header="Buscador maestro">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <WrapPanel Margin="0,0,0,6">
              <TextBox x:Name="MaestroNumero" Width="130" Margin="0,0,6,4" ToolTip="Número" />
              <ComboBox
                x:Name="MaestroTipo"
                Width="150"
                Margin="0,0,6,4"
                IsEditable="False"
                ToolTip="Tipo"
                SelectionChanged="MaestroFiltroChanged"
              />
              <TextBox
                x:Name="MaestroEmisor"
                Width="145"
                Margin="0,0,6,4"
                ToolTip="Emisor o proveedor"
                TextChanged="MaestroFiltroChanged"
              />
              <TextBox
                x:Name="MaestroCliente"
                Width="145"
                Margin="0,0,6,4"
                ToolTip="Cliente"
                TextChanged="MaestroFiltroChanged"
              />
              <TextBox
                x:Name="MaestroEncargado"
                Width="145"
                Margin="0,0,6,4"
                ToolTip="Encargado"
                TextChanged="MaestroFiltroChanged"
              />
              <ComboBox
                x:Name="MaestroGrupo"
                Width="115"
                Margin="0,0,6,4"
                SelectedIndex="2"
                SelectionChanged="MaestroFiltroChanged"
              >
                <ComboBoxItem Content="Emitido" />
                <ComboBoxItem Content="Recibido" />
                <ComboBoxItem Content="Todos" />
              </ComboBox>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
              <TextBlock Text="Fecha desde" VerticalAlignment="Center" Margin="0,0,4,4" />
              <DatePicker
                x:Name="MaestroFechaDesde"
                Width="135"
                Margin="0,0,8,4"
                SelectedDateChanged="MaestroFiltroChanged"
              />
              <TextBlock Text="hasta" VerticalAlignment="Center" Margin="0,0,4,4" />
              <DatePicker
                x:Name="MaestroFechaHasta"
                Width="135"
                Margin="0,0,8,4"
                SelectedDateChanged="MaestroFiltroChanged"
              />
              <Button
                Content="Buscar"
                Padding="10,4"
                Margin="0,0,6,4"
                Click="MaestroBuscar_Click"
              />
              <Button
                Content="Limpiar"
                Padding="10,4"
                Margin="0,0,6,4"
                Click="MaestroLimpiar_Click"
              />
            </WrapPanel>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid
              x:Name="MaestroResultados"
              Grid.Column="0"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionChanged="MaestroResultados_SelectionChanged"
              MouseDoubleClick="MaestroResultados_MouseDoubleClick"
              CanUserAddRows="False"
            >
              <DataGrid.Columns>
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoEmisor}" Width="150" />
                <DataGridTextColumn
                  Header="Números principales"
                  Binding="{Binding Numeros}"
                  Width="130"
                />
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="90" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="120" />
                <DataGridTextColumn Header="Encargado" Binding="{Binding Encargado}" Width="110" />
                <DataGridTextColumn Header="Cadena" Binding="{Binding Cadena}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Column="1" Margin="10,0,0,0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock
                  Text="Datos de este documento"
                  FontSize="16"
                  FontWeight="Bold"
                  VerticalAlignment="Center"
                />
                <Button
                  x:Name="MaestroVerCadena"
                  Content="Ver cadena"
                  Margin="8,0,0,0"
                  Padding="8,3"
                  Click="MaestroVerCadena_Click"
                  IsEnabled="False"
                />
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <ItemsControl x:Name="MaestroDatos">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,2">
                          <Button
                            DockPanel.Dock="Right"
                            Content="Copiar"
                            Padding="5,1"
                            Tag="{Binding Valor}"
                            Click="MaestroCopiar_Click"
                          />
                          <TextBlock
                            Text="{Binding Texto}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                          />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Documentos de la cadena" FontWeight="Bold" Margin="0,10,0,4" />
                  <ItemsControl x:Name="MaestroDatosCadena">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,4">
                          <TextBlock Text="{Binding Encabezado}" FontWeight="Bold" />
                          <ItemsControl ItemsSource="{Binding Datos}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <DockPanel Margin="0,1">
                                  <Button
                                    DockPanel.Dock="Right"
                                    Content="Copiar"
                                    Padding="5,1"
                                    Tag="{Binding Valor}"
                                    Click="MaestroCopiar_Click"
                                  />
                                  <TextBlock
                                    Text="{Binding Texto}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                  />
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Grid>
          <TextBlock
            x:Name="MaestroEstado"
            Grid.Row="2"
            Margin="0,6,0,0"
            Foreground="{DynamicResource Hormiguero.Error}"
            TextWrapping="Wrap"
          />
        </Grid>
      </TabItem>

      <TabItem Header="Carpetas">
        <DockPanel Margin="8">
          <TextBlock
            DockPanel.Dock="Top"
            Text="Carpetas observadas"
            FontSize="18"
            FontWeight="Bold"
            Margin="0,0,0,12"
          />

          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox
              x:Name="TextoRuta"
              Width="380"
              Margin="0,0,8,0"
              VerticalContentAlignment="Center"
              ToolTip="Pegue la ruta de una carpeta local o de red"
            />
            <Button
              x:Name="BotonExaminar"
              Content="Examinar..."
              Padding="8,4"
              Margin="0,0,8,0"
              Click="BotonExaminar_Click"
            />
            <Button
              x:Name="BotonAgregar"
              Content="Agregar carpeta"
              Padding="8,4"
              Click="BotonAgregar_Click"
            />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button
              x:Name="BotonQuitar"
              Content="Quitar"
              Padding="8,4"
              Margin="0,0,8,0"
              Click="BotonQuitar_Click"
            />
            <Button
              x:Name="BotonActualizarUbicacion"
              Content="Actualizar ubicación..."
              Padding="8,4"
              Margin="0,0,8,0"
              Click="BotonActualizarUbicacion_Click"
            />
            <Button
              x:Name="BotonVerificar"
              Content="Verificar accesibilidad"
              Padding="8,4"
              Click="BotonVerificar_Click"
            />
          </StackPanel>

          <TextBlock
            x:Name="TextoMensaje"
            DockPanel.Dock="Bottom"
            Margin="0,8,0,0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Hormiguero.Error}"
          />

          <ListView x:Name="ListaCarpetas" SelectionMode="Single">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Ruta" Width="450" DisplayMemberBinding="{Binding Ruta}" />
                <GridViewColumn
                  Header="Estado"
                  Width="150"
                  DisplayMemberBinding="{Binding Estado}"
                />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
