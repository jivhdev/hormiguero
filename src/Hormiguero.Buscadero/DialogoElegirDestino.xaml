<Window
  x:Class="Buscadero.App.DialogoElegirDestino"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Elegir documento destino"
  SizeToContent="Height"
  Width="580"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
>
  <StackPanel Margin="12">
    <TextBlock
      TextWrapping="Wrap"
      Margin="0,0,0,8"
      Text="Elija en qué documento de la cadena ubicar el documento observado:"
    />
    <ComboBox x:Name="ComboDestino" DisplayMemberPath="Etiqueta" Margin="0,0,0,12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button
        Content="Vincular"
        IsDefault="True"
        Width="100"
        Margin="0,0,8,0"
        Click="Aceptar_Click"
      />
      <Button Content="Cancelar" IsCancel="True" Width="90" />
    </StackPanel>
  </StackPanel>
</Window>
