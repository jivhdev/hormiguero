<Window
  x:Class="Buscadero.App.DialogoEsquemaDiccionario"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Esquema de documentos"
  Width="900"
  Height="700"
  MinWidth="760"
  MinHeight="600"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Documentos del proceso" FontSize="20" FontWeight="Bold" />
      <StackPanel Orientation="Horizontal" Margin="0,8">
        <TextBlock Text="Proveedor" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="Proveedor" Width="320" />
        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="18,0,8,0" />
        <TextBox x:Name="Nombre" Width="320" />
      </StackPanel>
      <TextBlock
        Text="Agregue los tipos que forman el proceso. La lista incluye el diccionario completo, agrupado por categoría."
        TextWrapping="Wrap"
        Margin="0,0,0,8"
      />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="1.2*" />
      </Grid.ColumnDefinitions>
      <DockPanel>
        <TextBlock
          DockPanel.Dock="Top"
          Text="Tipos del diccionario"
          FontWeight="Bold"
          Margin="0,0,0,5"
        />
        <ListBox x:Name="Tipos" DisplayMemberPath="Texto" />
      </DockPanel>
      <Button
        Grid.Column="1"
        Content="Agregar tipo →"
        Click="Agregar_Click"
        Margin="8"
        Padding="10,5"
        VerticalAlignment="Top"
      />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Top"
            Text="Lugares del esquema"
            FontWeight="Bold"
            Margin="0,0,0,5"
          />
          <DataGrid
            x:Name="Lugares"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="False"
          >
            <DataGrid.Columns>
              <DataGridTextColumn
                Header="Categoría"
                Binding="{Binding Grupo}"
                IsReadOnly="True"
                Width="*"
              />
              <DataGridTextColumn
                Header="Documento"
                Binding="{Binding Nombre}"
                IsReadOnly="True"
                Width="1.3*"
              />
              <DataGridCheckBoxColumn
                Header="Inicia cadena"
                Binding="{Binding Inicia}"
                Width="Auto"
              />
              <DataGridTemplateColumn Header="" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Quitar" Click="QuitarLugar_Click" Padding="6,2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="Enlaces declarados" FontWeight="Bold" Margin="0,12,0,5" />
        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel>
            <ComboBox
              x:Name="LugarA"
              Width="140"
              DisplayMemberPath="Nombre"
              SelectionChanged="Lugar_SelectionChanged"
              Margin="0,0,4,4"
            />
            <TextBlock Text="→" VerticalAlignment="Center" Margin="2,0,4,4" />
            <ComboBox
              x:Name="LugarB"
              Width="150"
              DisplayMemberPath="Nombre"
              SelectionChanged="Lugar_SelectionChanged"
              Margin="0,0,4,4"
            />
            <ComboBox x:Name="Dato" Width="210" DisplayMemberPath="Texto" Margin="0,0,4,4" />
          </WrapPanel>
          <WrapPanel Grid.Row="1" Margin="0,2,0,4">
            <ComboBox x:Name="Cardinalidad" Width="160" SelectedIndex="0" Margin="0,0,6,0">
              <ComboBoxItem Content="uno a uno" Tag="uno_a_uno" />
              <ComboBoxItem Content="uno a varios" Tag="uno_a_varios" />
            </ComboBox>
            <Button Content="Agregar enlace" Click="AgregarEnlace_Click" Padding="8,3" />
          </WrapPanel>
          <DockPanel Grid.Row="2">
            <Button
              DockPanel.Dock="Bottom"
              Content="Quitar enlace seleccionado"
              Click="QuitarEnlace_Click"
              HorizontalAlignment="Right"
              Padding="8,3"
              Margin="0,4,0,0"
            />
            <ListBox x:Name="Enlaces" />
          </DockPanel>
        </Grid>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <TextBlock x:Name="Estado" VerticalAlignment="Center" TextWrapping="Wrap" Width="600" />
      <Button Content="Guardar" Click="Guardar_Click" Padding="12,6" Margin="4" />
      <Button Content="Cancelar" IsCancel="True" Padding="12,6" Margin="4" />
    </StackPanel>
  </Grid>
</Window>
