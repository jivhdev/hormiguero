<Window
  x:Class="Buscadero.App.DialogoEsquemaDiccionario"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Esquema de documentos"
  Width="900"
  Height="680"
  MinWidth="760"
  MinHeight="440"
  WindowStartupLocation="CenterScreen"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock x:Name="TituloPaso" Text="Proveedor" FontSize="20" FontWeight="Bold" />
      <TextBlock
        x:Name="AyudaPaso"
        Text="Indique el proveedor y el nombre editable del proceso."
        TextWrapping="Wrap"
        Margin="0,4,0,0"
      />
    </StackPanel>
    <ScrollViewer
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
    >
      <Grid>
        <StackPanel x:Name="PanelProveedor" Margin="0,4">
          <TextBlock Text="Proveedor" FontWeight="Bold" Margin="0,0,0,4" />
          <ComboBox
            x:Name="Proveedor"
            Width="420"
            HorizontalAlignment="Left"
            IsEditable="True"
            IsTextSearchEnabled="True"
            StaysOpenOnEdit="True"
          />
          <TextBlock Text="Nombre del esquema" FontWeight="Bold" Margin="0,12,0,4" />
          <TextBox x:Name="Nombre" Width="420" HorizontalAlignment="Left" />
          <TextBlock Text="Se reconoce por" FontWeight="Bold" Margin="0,12,0,4" />
          <TextBlock
            Text="Agregue un RUT o un nombre de proveedor."
            Foreground="Gray"
            Margin="0,0,0,4"
          />
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="ReconocimientoNuevo" Width="340" />
            <Button
              Content="Agregar reconocimiento"
              Click="AgregarReconocimiento_Click"
              Margin="6,0,0,0"
              Padding="8,4"
            />
          </StackPanel>
          <ListBox x:Name="Reconocimientos" Width="420" Height="90" Margin="0,4,0,0" />
          <Button
            Content="Quitar seleccionado"
            Click="QuitarReconocimiento_Click"
            Width="150"
            HorizontalAlignment="Left"
            Margin="0,4,0,0"
          />
        </StackPanel>
        <Grid x:Name="PanelTipos" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock
              DockPanel.Dock="Top"
              Text="Documentos disponibles"
              FontWeight="Bold"
              Margin="0,0,0,5"
            />
            <ListBox
              x:Name="Tipos"
              DisplayMemberPath="NombreDocumento"
              MouseDoubleClick="Tipo_DoubleClick"
              MinHeight="300"
            >
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,7,0,2" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
            </ListBox>
          </DockPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8">
            <Button
              x:Name="AgregarTipo"
              Content="Agregar →"
              Click="Agregar_Click"
              Padding="10,5"
              Margin="0,3"
            />
            <Button
              x:Name="QuitarTipo"
              Content="← Quitar"
              Click="QuitarTipo_Click"
              Padding="10,5"
              Margin="0,3"
            />
          </StackPanel>
          <DockPanel Grid.Column="2">
            <StackPanel
              DockPanel.Dock="Bottom"
              Orientation="Horizontal"
              HorizontalAlignment="Center"
              Margin="0,6,0,0"
            >
              <Button Content="Subir" Click="SubirTipo_Click" Padding="10,4" Margin="3" />
              <Button Content="Bajar" Click="BajarTipo_Click" Padding="10,4" Margin="3" />
            </StackPanel>
            <TextBlock
              DockPanel.Dock="Top"
              Text="Documentos del proceso, en orden"
              FontWeight="Bold"
              Margin="0,0,0,5"
            />
            <ListBox
              x:Name="LugaresProceso"
              DisplayMemberPath="Nombre"
              MouseDoubleClick="LugarProceso_DoubleClick"
              SelectionChanged="LugarProceso_SelectionChanged"
              MinHeight="300"
            />
            <Border
              DockPanel.Dock="Bottom"
              BorderThickness="0,1,0,0"
              BorderBrush="Gray"
              Padding="6"
              Margin="0,6,0,0"
            >
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <TextBlock Text="Datos a marcar" FontWeight="Bold" />
                <DockPanel Grid.Row="1" Margin="0,4">
                  <Button
                    Content="Elegir…"
                    Click="ElegirCarpeta_Click"
                    DockPanel.Dock="Right"
                    Padding="8,3"
                  />
                  <TextBlock
                    Text="Carpeta donde buscarlo"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                  />
                  <TextBox
                    x:Name="CarpetaBusqueda"
                    ToolTip="Carpeta donde buscarlo"
                    TextChanged="CarpetaBusqueda_TextChanged"
                  />
                </DockPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="DatosMarcables">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox
                          Content="{Binding Nombre}"
                          IsChecked="{Binding Marcado, Mode=TwoWay}"
                          Margin="3,1"
                        />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </DockPanel>
        </Grid>
        <StackPanel x:Name="PanelDatosIngresados" Visibility="Collapsed" Margin="0,4">
          <TextBlock Text="Datos que escribo yo" FontWeight="Bold" Margin="0,0,0,6" />
          <DockPanel Margin="0,0,0,6">
            <Button
              Content="Agregar dato"
              Click="AgregarDatoIngresado_Click"
              DockPanel.Dock="Right"
              Padding="8,3"
            />
            <TextBox x:Name="DatoIngresadoNuevo" />
          </DockPanel>
          <ListBox x:Name="DatosIngresadosLista" MinHeight="220" />
          <Button
            Content="Quitar seleccionado"
            Click="QuitarDatoIngresado_Click"
            Width="150"
            HorizontalAlignment="Left"
            Margin="0,6,0,0"
          />
        </StackPanel>
        <DockPanel x:Name="PanelLugares" Visibility="Collapsed">
          <TextBlock
            DockPanel.Dock="Top"
            Text="Marque los documentos que pueden iniciar la cadena."
            Margin="0,0,0,8"
          />
          <DataGrid
            x:Name="Lugares"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="False"
            MinHeight="300"
          >
            <DataGrid.Columns>
              <DataGridTextColumn
                Header="Categoría"
                Binding="{Binding Grupo}"
                IsReadOnly="True"
                Width="*"
              />
              <DataGridTextColumn
                Header="Documento"
                Binding="{Binding Nombre}"
                IsReadOnly="True"
                Width="1.3*"
              />
              <DataGridCheckBoxColumn
                Header="Inicia cadena"
                Binding="{Binding Inicia}"
                Width="Auto"
              />
              <DataGridTemplateColumn Header="" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Quitar" Click="QuitarLugar_Click" Padding="6,2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <Grid x:Name="PanelEnlaces" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel>
            <StackPanel Margin="0,0,8,4">
              <TextBlock Text="Documento A" />
              <ComboBox
                x:Name="LugarA"
                Width="175"
                DisplayMemberPath="Nombre"
                SelectionChanged="Lugar_SelectionChanged"
              />
            </StackPanel>
            <StackPanel Margin="0,0,8,4">
              <TextBlock Text="Documento B" />
              <ComboBox
                x:Name="LugarB"
                Width="175"
                DisplayMemberPath="Nombre"
                SelectionChanged="Lugar_SelectionChanged"
              />
            </StackPanel>
            <StackPanel Margin="0,0,8,4">
              <TextBlock Text="Por qué dato" />
              <ComboBox x:Name="Dato" Width="260" DisplayMemberPath="Texto" />
            </StackPanel>
          </WrapPanel>
          <WrapPanel Grid.Row="1" Margin="0,5,0,8">
            <ComboBox x:Name="Cardinalidad" Width="170" SelectedIndex="0" Margin="0,0,8,0">
              <ComboBoxItem Content="Uno a uno" Tag="uno_a_uno" />
              <ComboBoxItem Content="Uno a varios" Tag="uno_a_varios" />
            </ComboBox>
            <Button Content="Agregar enlace" Click="AgregarEnlace_Click" Padding="8,3" />
          </WrapPanel>
          <DockPanel Grid.Row="2">
            <Button
              DockPanel.Dock="Bottom"
              Content="Quitar enlace seleccionado"
              Click="QuitarEnlace_Click"
              HorizontalAlignment="Right"
              Padding="8,3"
              Margin="0,4,0,0"
            />
            <ListBox x:Name="Enlaces" MinHeight="220" />
          </DockPanel>
        </Grid>
        <Grid x:Name="PanelModos" Visibility="Collapsed" Margin="0,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Text="Opcional. Si el proceso tiene variantes, por ejemplo Retiro o Despacho, escríbalas aquí; Archivero preguntará cuál es al llegar el documento que decide."
            TextWrapping="Wrap"
            Margin="0,0,0,10"
          />
          <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,8">
            <TextBox x:Name="ModoNuevo" Width="260" Margin="0,0,8,0" />
            <Button Content="Agregar" Click="AgregarModo_Click" Padding="10,4" Margin="0,0,6,0" />
            <Button Content="Quitar" Click="QuitarModo_Click" Padding="10,4" />
          </DockPanel>
          <ListBox x:Name="ModosLista" Grid.Row="2" MinHeight="160" />
          <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock
              Text="Documento que decide el modo"
              VerticalAlignment="Center"
              Margin="0,0,10,0"
            />
            <ComboBox x:Name="LugarDecideModo" Width="300" DisplayMemberPath="Nombre" />
          </DockPanel>
          <TextBlock
            Grid.Row="4"
            Text="Proponer el modo cuando el texto contenga…"
            FontWeight="Bold"
            Margin="0,12,0,6"
          />
          <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,0,0,6">
            <TextBox
              x:Name="ContienePropuesta"
              Width="220"
              Margin="0,0,6,0"
              ToolTip="Texto que se buscará en el dato marcado de la OCC"
            />
            <ComboBox x:Name="ModoPropuestaNuevo" Width="180" Margin="0,0,6,0" />
            <Button Content="Agregar regla" Click="AgregarReglaPropuesta_Click" Padding="8,3" />
            <Button
              Content="Actualizar seleccionada"
              Click="ActualizarReglaPropuesta_Click"
              Padding="8,3"
              Margin="6,0,0,0"
            />
          </DockPanel>
          <DockPanel Grid.Row="6">
            <Button
              DockPanel.Dock="Bottom"
              Content="Quitar regla seleccionada"
              Click="QuitarReglaPropuesta_Click"
              HorizontalAlignment="Right"
              Padding="8,3"
              Margin="0,4,0,0"
            />
            <ListBox
              x:Name="ReglasPropuestaLista"
              MinHeight="90"
              SelectionChanged="ReglaPropuesta_SelectionChanged"
            />
          </DockPanel>
        </Grid>
        <DockPanel x:Name="PanelAvisos" Visibility="Collapsed" Margin="0,4">
          <StackPanel
            DockPanel.Dock="Bottom"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,8,0,0"
          >
            <Button
              x:Name="BotonAgregarAviso"
              Content="Agregar aviso…"
              Click="AgregarAviso_Click"
              Padding="10,5"
              Margin="3"
            />
            <Button
              x:Name="BotonEditarAviso"
              Content="Editar…"
              Click="EditarAviso_Click"
              Padding="10,5"
              Margin="3"
            />
            <Button Content="Quitar" Click="QuitarAviso_Click" Padding="10,5" Margin="3" />
          </StackPanel>
          <Grid>
            <ListBox
              x:Name="ListaAvisos"
              MouseDoubleClick="EditarAviso_DoubleClick"
              MinHeight="220"
              DisplayMemberPath="Frase"
            />
            <TextBlock
              x:Name="SinAvisos"
              Text="Todavía no hay avisos. Son opcionales."
              Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
            />
          </Grid>
        </DockPanel>
        <TextBlock x:Name="PanelResumen" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4" />
      </Grid>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock
        x:Name="Estado"
        DockPanel.Dock="Left"
        VerticalAlignment="Center"
        TextWrapping="Wrap"
        Width="360"
      />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="NumeroPaso" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button
          x:Name="Anterior"
          Content="Anterior"
          Click="Anterior_Click"
          Padding="10,6"
          Margin="4"
        />
        <Button
          x:Name="Siguiente"
          Content="Siguiente"
          Click="Siguiente_Click"
          Padding="10,6"
          Margin="4"
        />
        <Button
          x:Name="Guardar"
          Content="Guardar"
          Click="Guardar_Click"
          Padding="12,6"
          Margin="4"
          Visibility="Collapsed"
        />
        <Button x:Name="Cancelar" Content="Cancelar" IsCancel="True" Padding="12,6" Margin="4" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
