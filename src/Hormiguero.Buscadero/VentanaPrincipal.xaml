<Window
  x:Class="Hormiguero.Buscadero.VentanaPrincipal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Buscadero"
  WindowState="Maximized"
  Background="{DynamicResource Hormiguero.Fondo}"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border
      Grid.Row="0"
      Background="{DynamicResource Hormiguero.Principal}"
      Padding="{DynamicResource Hormiguero.Margen}"
    >
      <TextBlock
        Text="Buscadero"
        FontSize="{DynamicResource Hormiguero.TextoTitulo}"
        Foreground="{DynamicResource Hormiguero.PrincipalTexto}"
        VerticalAlignment="Center"
      />
    </Border>

    <TextBlock
      Grid.Row="1"
      Text="Aquí irá el buscador"
      FontSize="{DynamicResource Hormiguero.TextoNormal}"
      Foreground="{DynamicResource Hormiguero.Texto}"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
    />
  </Grid>
</Window>
