<Window
  x:Class="Buscadero.App.DialogoPreferenciaNombre"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Nombre de las cadenas"
  SizeToContent="WidthAndHeight"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
>
  <StackPanel Margin="16" MaxWidth="400">
    <TextBlock
      Text="¿Cómo querés que se nombren las cadenas documentales que se creen con este modelo?"
      TextWrapping="Wrap"
      Margin="0,0,0,12"
      FontWeight="Bold"
    />
    <TextBlock
      Text="Esta elección se hace una sola vez por modelo y se aplica a todas sus cadenas, presentes y futuras."
      TextWrapping="Wrap"
      Foreground="{DynamicResource Hormiguero.TextoSecundario}"
      Margin="0,0,0,12"
    />

    <RadioButton
      x:Name="OpcionPorDocumento"
      Content="Nombre por documento"
      GroupName="Preferencia"
      Checked="Opcion_Changed"
      Unchecked="Opcion_Changed"
      Margin="0,0,0,4"
    />
    <ComboBox
      x:Name="ComboDocumento"
      DisplayMemberPath="Nombre"
      IsEnabled="False"
      Margin="20,0,0,10"
    />

    <RadioButton
      x:Name="OpcionPersonalizado"
      Content="Nombre personalizado"
      GroupName="Preferencia"
      Checked="Opcion_Changed"
      Unchecked="Opcion_Changed"
      Margin="0,0,0,10"
    />

    <RadioButton
      x:Name="OpcionGenerico"
      Content="Nombre genérico (Cadena 1, Cadena 2, ...)"
      GroupName="Preferencia"
      IsChecked="True"
      Checked="Opcion_Changed"
      Unchecked="Opcion_Changed"
      Margin="0,0,0,16"
    />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Continuar" IsDefault="True" Width="110" Click="Continuar_Click" />
    </StackPanel>
  </StackPanel>
</Window>
