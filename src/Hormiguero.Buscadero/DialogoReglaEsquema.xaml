<Window
  x:Class="Buscadero.App.DialogoReglaEsquema"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Configurar aviso"
  Width="760"
  Height="720"
  MinWidth="640"
  MinHeight="600"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock
        x:Name="Frase"
        TextWrapping="Wrap"
        Margin="0,8"
        Padding="10"
        Background="{DynamicResource Hormiguero.Superficie}"
      />
      <TextBlock
        x:Name="Estado"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Hormiguero.Error}"
      />
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="Guardar aviso" Click="Guardar_Click" Padding="12,6" Margin="0,6,6,0" />
        <Button Content="Cancelar" Click="Cancelar_Click" Padding="12,6" Margin="0,6,0,0" />
      </WrapPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Tipo de aviso" FontWeight="Bold" />
        <ComboBox
          x:Name="Tipo"
          SelectedIndex="0"
          SelectionChanged="Actualizar_Click"
          Margin="0,4,0,10"
        >
          <ComboBoxItem Content="Falta ingresar un dato" />
          <ComboBoxItem Content="Plazo entre documentos" />
          <ComboBoxItem Content="Listo para…" />
        </ComboBox>
        <TextBlock Text="Este aviso aplica al modo" />
        <ComboBox x:Name="Modo" DisplayMemberPath="Nombre" Margin="0,4,0,8" />
        <TextBlock Text="Lugar al que pertenece el aviso" />
        <ComboBox x:Name="LugarRegla" DisplayMemberPath="Nombre" Margin="0,4,0,8" />
        <TextBlock Text="Falta ingresar un dato: nombre" />
        <TextBox
          x:Name="Dato"
          Text="Fecha de retiro"
          Margin="0,4,0,8"
          TextChanged="Actualizar_Click"
        />
        <TextBlock Text="Plazo: desde el lugar o dato" />
        <ComboBox x:Name="DesdeLugar" DisplayMemberPath="Nombre" Margin="0,4,0,8" />
        <TextBlock Text="O desde un dato ingresado (dejar vacío para usar el lugar)" />
        <TextBox x:Name="DesdeDato" Margin="0,4,0,8" TextChanged="Actualizar_Click" />
        <TextBlock Text="Esperar días" />
        <TextBox x:Name="Dias" Text="7" Margin="0,4,0,8" TextChanged="Actualizar_Click" />
        <ComboBox x:Name="TipoDias" SelectedIndex="1" Margin="0,4,0,8">
          <ComboBoxItem Content="Días hábiles" />
          <ComboBoxItem Content="Días corridos" />
        </ComboBox>
        <TextBlock Text="Calendario de feriados (opcional)" />
        <ComboBox x:Name="Calendario" DisplayMemberPath="Nombre" Margin="0,4,0,8" />
        <TextBlock Text="Hasta que llegue (o lugar esperado)" />
        <ComboBox x:Name="Hasta" DisplayMemberPath="Nombre" Margin="0,4,0,8" />
        <TextBlock Text="Solo si existe (opcional) / y exista" />
        <ComboBox x:Name="Condicion" DisplayMemberPath="Nombre" Margin="0,4,0,8" />
        <CheckBox
          x:Name="PorLinea"
          Content="Evaluar por cada línea de una pareja"
          Margin="0,4,0,8"
        />
        <TextBlock Text="Listo para: cuando llegue" />
        <ComboBox x:Name="Cuando" DisplayMemberPath="Nombre" Margin="0,4,0,8" />
        <TextBlock Text="Nombre de la lista Listos para…" />
        <TextBox
          x:Name="Lista"
          Text="Listos para facturar al cliente"
          Margin="0,4,0,8"
          TextChanged="Actualizar_Click"
        />
        <TextBlock Text="Texto del aviso" />
        <TextBox
          x:Name="Texto"
          Text="Falta el documento esperado"
          Margin="0,4,0,8"
          TextChanged="Actualizar_Click"
        />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
