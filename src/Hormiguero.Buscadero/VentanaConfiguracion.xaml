<Window
  x:Class="Hormiguero.Buscadero.VentanaConfiguracion"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Configuración"
  Width="760"
  Height="640"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Hormiguero.Fondo}"
  KeyDown="Ventana_KeyDown"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Hormiguero.Margen}">
    <StackPanel>
      <!-- Sección Carpetas -->
      <Border
        Background="{DynamicResource Hormiguero.Superficie}"
        BorderBrush="{DynamicResource Hormiguero.Borde}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Hormiguero.Radio}"
        Padding="{DynamicResource Hormiguero.Margen}"
        Margin="0,0,0,{DynamicResource Hormiguero.Espacio}"
      >
        <StackPanel>
          <TextBlock
            Text="Carpetas"
            FontSize="{DynamicResource Hormiguero.TextoTitulo}"
            Foreground="{DynamicResource Hormiguero.Texto}"
            Margin="0,0,0,8"
          />
          <TextBlock
            Text="Administra las carpetas donde Buscadero busca tus documentos."
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            TextWrapping="Wrap"
            Margin="0,0,0,16"
          />
          <ContentControl x:Name="Carpetas" />
        </StackPanel>
      </Border>

      <!-- Sección Impresión -->
      <Border
        Background="{DynamicResource Hormiguero.Superficie}"
        BorderBrush="{DynamicResource Hormiguero.Borde}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Hormiguero.Radio}"
        Padding="{DynamicResource Hormiguero.Margen}"
      >
        <StackPanel>
          <TextBlock
            Text="Impresión"
            FontSize="{DynamicResource Hormiguero.TextoTitulo}"
            Foreground="{DynamicResource Hormiguero.Texto}"
            Margin="0,0,0,8"
          />
          <TextBlock
            Text="Elige cómo se imprimen los documentos desde el visor."
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            TextWrapping="Wrap"
            Margin="0,0,0,16"
          />

          <StackPanel x:Name="OpcionesImpresion" Orientation="Vertical">
            <RadioButton
              x:Name="RbDirecta"
              GroupName="ModoImpresion"
              Content="Directa (impresora predeterminada de Windows)"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Foreground="{DynamicResource Hormiguero.Texto}"
              Margin="0,0,0,8"
              Checked="ModoImpresion_Checked"
            />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <RadioButton
                x:Name="RbImpresoraFija"
                GroupName="ModoImpresion"
                Content="Otra impresora fija:"
                FontSize="{DynamicResource Hormiguero.TextoNormal}"
                Foreground="{DynamicResource Hormiguero.Texto}"
                VerticalAlignment="Center"
                Checked="ModoImpresion_Checked"
              />
              <ComboBox
                x:Name="Impresoras"
                Width="300"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontSize="{DynamicResource Hormiguero.TextoNormal}"
                IsEnabled="False"
                SelectionChanged="Impresoras_SelectionChanged"
              />
            </StackPanel>
            <RadioButton
              x:Name="RbCuadroWindows"
              GroupName="ModoImpresion"
              Content="Cuadro de impresión de Windows"
              FontSize="{DynamicResource Hormiguero.TextoNormal}"
              Foreground="{DynamicResource Hormiguero.Texto}"
              Margin="0,0,0,8"
              Checked="ModoImpresion_Checked"
            />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Botón Cerrar -->
      <Button
        x:Name="BtnCerrar"
        Content="Cerrar"
        FontSize="{DynamicResource Hormiguero.TextoNormal}"
        Padding="16,8"
        HorizontalAlignment="Right"
        Margin="0,{DynamicResource Hormiguero.Espacio},0,0"
        Click="Cerrar_Click"
        IsCancel="True"
      />
    </StackPanel>
  </ScrollViewer>
</Window>
