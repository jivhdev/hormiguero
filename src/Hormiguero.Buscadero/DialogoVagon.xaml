<Window
  x:Class="Buscadero.App.DialogoVagon"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Documento"
  SizeToContent="WidthAndHeight"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
>
  <StackPanel Margin="12">
    <TextBlock Text="Nombre del documento:" />
    <TextBox x:Name="TextoNombre" Width="360" Margin="0,6,0,12" />
    <CheckBox
      x:Name="CheckMultiple"
      Content="Documento ramificado (abre cadenas hijas de otro modelo)"
      Margin="0,0,0,6"
      Checked="CheckMultiple_Changed"
      Unchecked="CheckMultiple_Changed"
    />
    <StackPanel
      x:Name="PanelModeloHijo"
      Orientation="Horizontal"
      Margin="20,0,0,10"
      IsEnabled="False"
    >
      <TextBlock Text="Modelo de cadena hija:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox x:Name="ComboModeloHijo" Width="250" DisplayMemberPath="Etiqueta" />
    </StackPanel>
    <CheckBox
      x:Name="CheckAnexo"
      Content="Documento anexo (opcional, cuelga de un documento principal)"
      Margin="0,0,0,12"
    />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button
        Content="Aceptar"
        IsDefault="True"
        Width="90"
        Margin="0,0,8,0"
        Click="Aceptar_Click"
      />
      <Button Content="Cancelar" IsCancel="True" Width="90" />
    </StackPanel>
  </StackPanel>
</Window>
