<Window
  x:Class="Buscadero.App.DialogoComparar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Comparar con..."
  SizeToContent="Height"
  Width="540"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
>
  <StackPanel Margin="12">
    <TextBlock Text="Segundo documento (de la misma cadena):" Margin="0,0,0,4" />
    <ComboBox x:Name="ComboDocumentos" DisplayMemberPath="Etiqueta" Margin="0,0,0,10" />
    <TextBlock
      x:Name="TextoAyuda"
      TextWrapping="Wrap"
      Foreground="{DynamicResource Hormiguero.TextoSecundario}"
      Margin="0,0,0,10"
      Text="También puede buscar un documento cualquiera."
    />
    <Button
      x:Name="BotonBuscar"
      Content="Buscar documento..."
      HorizontalAlignment="Left"
      Padding="8,4"
      Margin="0,0,0,12"
      Click="BotonBuscar_Click"
    />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button
        Content="Comparar"
        IsDefault="True"
        Width="110"
        Margin="0,0,8,0"
        Click="Aceptar_Click"
      />
      <Button Content="Cancelar" IsCancel="True" Width="90" />
    </StackPanel>
  </StackPanel>
</Window>
