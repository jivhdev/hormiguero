<Window
  x:Class="Buscadero.App.DialogoCalculadoraFechas"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Calcular fecha"
  Height="330"
  Width="500"
  MinHeight="300"
  MinWidth="420"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <StackPanel Margin="20">
    <TextBlock Text="Fecha inicial" Margin="0,0,0,4" />
    <DatePicker x:Name="Fecha" SelectedDateChanged="Cambiar_Click" />
    <TextBlock Text="Cantidad de días" Margin="0,12,0,4" />
    <TextBox x:Name="Cantidad" Text="5" Padding="8" TextChanged="Cambiar_Click" />
    <TextBlock Text="Tipo de días" Margin="0,12,0,4" />
    <ComboBox x:Name="Modo" SelectedIndex="0" SelectionChanged="Cambiar_Click">
      <ComboBoxItem Content="Hábiles" />
      <ComboBoxItem Content="Corridos" />
    </ComboBox>
    <TextBlock Text="Calendario" Margin="0,12,0,4" />
    <ComboBox x:Name="Calendario" DisplayMemberPath="Nombre" SelectionChanged="Cambiar_Click" />
    <TextBlock
      x:Name="Resultado"
      FontSize="18"
      FontWeight="Bold"
      Margin="0,18,0,0"
      Text="Elija los datos para calcular."
    />
  </StackPanel>
</Window>
