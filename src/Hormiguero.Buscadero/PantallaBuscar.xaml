<UserControl
  x:Class="Hormiguero.Buscadero.PantallaBuscar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{DynamicResource Hormiguero.Fondo}"
>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Buscador y resultados (izquierda) -->
    <Border
      Grid.Column="0"
      Background="{DynamicResource Hormiguero.Superficie}"
      BorderBrush="{DynamicResource Hormiguero.Borde}"
      BorderThickness="0,0,1,0"
      Padding="{DynamicResource Hormiguero.Margen}"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <!-- Buscador -->
          <RowDefinition Height="Auto" />
          <!-- Alcance -->
          <RowDefinition Height="Auto" />
          <!-- Carpeta específica -->
          <RowDefinition Height="*" />
          <!-- Resultados -->
          <RowDefinition Height="Auto" />
          <!-- Estado -->
        </Grid.RowDefinitions>

        <!-- Fila del buscador -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
            x:Name="CampoNumero"
            Grid.Column="0"
            FontSize="{DynamicResource Hormiguero.TextoTitulo}"
            VerticalAlignment="Center"
            Padding="8,4"
            KeyDown="CampoNumero_KeyDown"
          />
          <Button
            x:Name="BtnBuscar"
            Grid.Column="1"
            Content="Buscar"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Padding="16,8"
            Margin="8,0,0,0"
            MinHeight="{DynamicResource Hormiguero.AltoBoton}"
            Click="BtnBuscar_Click"
          />
          <Button
            x:Name="BtnCancelar"
            Grid.Column="2"
            Content="Cancelar"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Padding="16,8"
            Margin="8,0,0,0"
            MinHeight="{DynamicResource Hormiguero.AltoBoton}"
            Click="BtnCancelar_Click"
            Visibility="Collapsed"
          />
        </Grid>

        <!-- Alcance -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
          <TextBlock
            Text="Alcance:"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Foreground="{DynamicResource Hormiguero.Texto}"
            VerticalAlignment="Center"
            Margin="0,0,8,0"
          />
          <ComboBox
            x:Name="ComboAlcance"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Width="200"
            SelectionChanged="ComboAlcance_SelectionChanged"
          >
            <ComboBoxItem
              Content="Primera coincidencia"
              Tag="PrimeraCoincidencia"
              IsSelected="True"
            />
            <ComboBoxItem Content="Todas las carpetas" Tag="TodasLasCarpetas" />
            <ComboBoxItem Content="Carpeta específica" Tag="CarpetaEspecifica" />
          </ComboBox>
        </StackPanel>

        <!-- Carpeta específica (visible solo cuando se selecciona) -->
        <StackPanel
          x:Name="PanelCarpetaEspecifica"
          Grid.Row="2"
          Margin="0,0,0,12"
          Visibility="Collapsed"
        >
          <TextBlock
            Text="Carpeta:"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Foreground="{DynamicResource Hormiguero.Texto}"
            Margin="0,0,0,4"
          />
          <ComboBox
            x:Name="ComboCarpetaEspecifica"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            DisplayMemberPath="."
          />
        </StackPanel>

        <!-- Resultados -->
        <ListBox
          x:Name="ListaResultados"
          Grid.Row="3"
          Margin="0,0,0,8"
          BorderThickness="0"
          SelectionChanged="ListaResultados_SelectionChanged"
        >
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,8,0,0">
                <TextBlock
                  Text="{Binding Titulo}"
                  FontSize="{DynamicResource Hormiguero.TextoTitulo}"
                  Foreground="{DynamicResource Hormiguero.Texto}"
                  TextWrapping="Wrap"
                />
                <TextBlock
                  Text="{Binding Detalle}"
                  Margin="0,4,0,0"
                  FontSize="{DynamicResource Hormiguero.TextoNormal}"
                  Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Estado -->
        <StackPanel Grid.Row="4">
          <TextBlock
            x:Name="Estado"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Foreground="{DynamicResource Hormiguero.TextoSecundario}"
            TextWrapping="Wrap"
          />
          <Button
            x:Name="BtnBuscarEnTodas"
            Content="Buscar en todas"
            FontSize="{DynamicResource Hormiguero.TextoNormal}"
            Padding="16,8"
            Margin="0,8,0,0"
            HorizontalAlignment="Left"
            Click="BtnBuscarEnTodas_Click"
            Visibility="Collapsed"
          />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Visor (derecha) - reservado para bloque siguiente -->
    <Border
      x:Name="Visor"
      Grid.Column="1"
      Background="{DynamicResource Hormiguero.Superficie}"
      BorderBrush="{DynamicResource Hormiguero.Borde}"
      BorderThickness="1"
      CornerRadius="{DynamicResource Hormiguero.Radio}"
      Margin="{DynamicResource Hormiguero.Margen}"
      Padding="{DynamicResource Hormiguero.Margen}"
    >
      <TextBlock
        Text="Elige un documento para verlo"
        FontSize="{DynamicResource Hormiguero.TextoTitulo}"
        Foreground="{DynamicResource Hormiguero.TextoSecundario}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        TextWrapping="Wrap"
      />
    </Border>
  </Grid>
</UserControl>
