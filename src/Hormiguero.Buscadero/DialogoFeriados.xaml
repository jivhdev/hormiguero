<Window
  x:Class="Buscadero.App.DialogoFeriados"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Feriados"
  Height="540"
  Width="760"
  MinHeight="460"
  MinWidth="620"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Calendario" Margin="0,0,0,5" />
      <ComboBox
        x:Name="Calendarios"
        DisplayMemberPath="Nombre"
        SelectionChanged="Calendarios_SelectionChanged"
      />
      <WrapPanel Margin="0,10,0,10">
        <DatePicker x:Name="Fecha" Width="145" />
        <TextBox x:Name="Nombre" Width="230" Padding="7" Margin="8,0" />
        <Button Content="Agregar feriado" Padding="10,6" Click="Agregar_Click" />
      </WrapPanel>
      <WrapPanel Margin="0,0,0,10">
        <Button Content="Importar CSV" Padding="10,6" Margin="0,0,8,0" Click="Importar_Click" />
        <Button Content="Exportar CSV" Padding="10,6" Click="Exportar_Click" />
      </WrapPanel>
    </StackPanel>
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,10,0,0"
    >
      <Button Content="Anular seleccionado" Padding="12,8" Margin="0,0,8,0" Click="Anular_Click" />
      <Button Content="Cerrar" Padding="12,8" Click="Cerrar_Click" />
    </StackPanel>
    <DataGrid
      x:Name="Lista"
      AutoGenerateColumns="False"
      IsReadOnly="True"
      SelectionMode="Single"
      CanUserAddRows="False"
      Background="{DynamicResource Hormiguero.Fondo}"
      Foreground="{DynamicResource Hormiguero.Texto}"
    >
      <DataGrid.Columns>
        <DataGridTextColumn
          Header="Fecha"
          Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}"
          Width="140"
        />
        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Activo}" Width="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
