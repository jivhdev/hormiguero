<Window
  x:Class="Buscadero.App.DialogoAlertas"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Alertas"
  Height="560"
  Width="900"
  MinHeight="480"
  MinWidth="720"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <WrapPanel Margin="0,0,0,10">
        <TextBlock Text="Mostrar:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox
          x:Name="Filtro"
          Width="180"
          SelectedIndex="0"
          SelectionChanged="Filtro_SelectionChanged"
        >
          <ComboBoxItem Content="Pendientes" />
          <ComboBoxItem Content="Vencidas" />
          <ComboBoxItem Content="Resueltas" />
          <ComboBoxItem Content="Todas" />
        </ComboBox>
        <Button Content="Revisar ahora" Padding="12,7" Margin="12,0,0,0" Click="Revisar_Click" />
      </WrapPanel>
    </StackPanel>
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,10,0,0"
    >
      <Button Content="Ver cadena" Padding="14,9" Margin="0,0,8,0" Click="VerCadena_Click" />
      <Button Content="Resolver" Padding="14,9" Margin="0,0,8,0" Click="Resolver_Click" />
      <Button Content="Descartar" Padding="14,9" Margin="0,0,8,0" Click="Descartar_Click" />
      <Button Content="Reabrir" Padding="14,9" Margin="0,0,8,0" Click="Reabrir_Click" />
      <Button Content="Cerrar" Padding="14,9" Click="Cerrar_Click" />
    </StackPanel>
    <DataGrid
      x:Name="Lista"
      AutoGenerateColumns="False"
      IsReadOnly="True"
      SelectionMode="Single"
      CanUserAddRows="False"
      Background="{DynamicResource Hormiguero.Fondo}"
      Foreground="{DynamicResource Hormiguero.Texto}"
      HeadersVisibility="Column"
    >
      <DataGrid.Columns>
        <DataGridTextColumn Header="Qué falta o qué hacer" Binding="{Binding Texto}" Width="2*" />
        <DataGridTextColumn Header="Cadena" Binding="{Binding Cadena}" Width="*" />
        <DataGridTextColumn Header="Para cuándo" Binding="{Binding ParaCuando}" Width="*" />
        <DataGridTextColumn Header="Estado" Binding="{Binding EstadoVisible}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
