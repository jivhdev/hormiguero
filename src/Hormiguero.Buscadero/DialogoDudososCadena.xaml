<Window
  x:Class="Buscadero.App.DialogoDudososCadena"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Dudosos de la cadena"
  Width="740"
  Height="520"
  MinWidth="560"
  MinHeight="400"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <DockPanel Margin="14">
    <TextBlock
      x:Name="Titulo"
      DockPanel.Dock="Top"
      FontSize="19"
      FontWeight="Bold"
      Margin="0,0,0,8"
    />
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,8,0,0"
    >
      <Button Content="Aceptar" Click="Aceptar_Click" Padding="12,6" Margin="4" />
      <Button Content="Rechazar" Click="Rechazar_Click" Padding="12,6" Margin="4" />
      <Button Content="Cerrar" IsCancel="True" Padding="12,6" Margin="4" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="Lista" SelectionChanged="Lista_SelectionChanged" Margin="0,0,10,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4">
              <TextBlock Text="{Binding Nombre}" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock
                Text="{Binding Motivo}"
                Foreground="{DynamicResource Hormiguero.TextoSecundario}"
                TextWrapping="Wrap"
              />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Documento" FontWeight="Bold" />
        <TextBlock x:Name="Documento" TextWrapping="Wrap" Margin="0,4,0,12" />
        <TextBlock Text="Motivo" FontWeight="Bold" />
        <TextBlock x:Name="Motivo" TextWrapping="Wrap" Margin="0,4,0,12" />
        <TextBlock
          x:Name="Estado"
          TextWrapping="Wrap"
          Foreground="{DynamicResource Hormiguero.Error}"
        />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
