<Window
  x:Class="Buscadero.App.DialogoReglaVagon"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Completar documentos automáticamente"
  Width="650"
  Height="620"
  MinHeight="560"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
>
  <DockPanel Margin="14">
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,12,0,0"
    >
      <Button
        Content="Guardar"
        IsDefault="True"
        Padding="12,5"
        Margin="0,0,8,0"
        Click="Guardar_Click"
      />
      <Button
        Content="Guardar regla y elegir otro documento"
        Padding="10,5"
        Margin="0,0,8,0"
        Click="GuardarOtra_Click"
      />
      <Button Content="Cancelar" IsCancel="True" Padding="12,5" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock
          Text="¿Cuándo se completa este documento automáticamente?"
          FontSize="18"
          FontWeight="Bold"
          TextWrapping="Wrap"
          Margin="0,0,0,12"
          Foreground="{DynamicResource Hormiguero.Texto}"
        />
        <TextBlock Text="Documento que se completará:" />
        <ComboBox
          x:Name="ComboDestino"
          DisplayMemberPath="Nombre"
          Margin="0,4,0,10"
          SelectionChanged="Seleccion_Changed"
        />
        <TextBlock Text="No completar automáticamente" Margin="0,0,0,10" />
        <TextBlock
          x:Name="TextoSinDatos"
          Text="Archivero todavía no ha publicado configuraciones y datos para comparar."
          TextWrapping="Wrap"
          Margin="0,0,0,10"
          Visibility="Collapsed"
          Foreground="{DynamicResource Hormiguero.TextoSecundario}"
        />
        <TextBlock Text="Configuración de Archivero:" />
        <ComboBox
          x:Name="ComboConfiguracion"
          DisplayMemberPath="Nombre"
          Margin="0,4,0,10"
          SelectionChanged="Configuracion_Changed"
        />
        <TextBlock Text="Dato que llega:" />
        <ComboBox
          x:Name="ComboCampoOrigen"
          DisplayMemberPath="Nombre"
          Margin="0,4,0,10"
          SelectionChanged="Seleccion_Changed"
        />
        <TextBlock Text="Documento de la cadena con el que se compara:" />
        <ComboBox
          x:Name="ComboComparacion"
          DisplayMemberPath="Nombre"
          Margin="0,4,0,10"
          SelectionChanged="Seleccion_Changed"
        />
        <TextBlock Text="Dato de ese documento:" />
        <ComboBox
          x:Name="ComboCampoComparacion"
          DisplayMemberPath="Etiqueta"
          Margin="0,4,0,10"
          SelectionChanged="Seleccion_Changed"
        />
        <TextBlock Text="¿Cómo deben coincidir los datos?" FontWeight="Bold" Margin="0,8,0,6" />
        <CheckBox x:Name="CheckEspacios" Content="Ignorar espacios" Margin="0,0,0,4" />
        <CheckBox x:Name="CheckGuiones" Content="Ignorar guiones" Margin="0,0,0,4" />
        <CheckBox x:Name="CheckCeros" Content="Ignorar ceros a la izquierda" Margin="0,0,0,8" />
        <WrapPanel>
          <TextBlock Text="Largo mínimo:" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="TextoLargo" Width="65" Text="6" TextChanged="Seleccion_Changed" />
        </WrapPanel>
        <TextBlock
          Text="Ejemplo: con espacios ignorados, “ AB 123 ” y “AB 123” se consideran iguales."
          TextWrapping="Wrap"
          Margin="0,8,0,8"
          Foreground="{DynamicResource Hormiguero.TextoSecundario}"
        />
        <TextBlock Text="Frase completa:" FontWeight="Bold" />
        <TextBlock
          x:Name="TextoFrase"
          Text="No completar automáticamente"
          TextWrapping="Wrap"
          Margin="0,4,0,10"
          Foreground="{DynamicResource Hormiguero.Principal}"
        />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
