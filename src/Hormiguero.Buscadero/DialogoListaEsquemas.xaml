<Window
  x:Class="Buscadero.App.DialogoListaEsquemas"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Esquemas por proveedor"
  Width="620"
  Height="500"
  MinWidth="500"
  MinHeight="380"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Esquemas del proveedor" FontSize="20" FontWeight="Bold" />
      <TextBlock
        Text="Cada proveedor puede tener un esquema. Seleccione uno para editarlo o desactivarlo."
        TextWrapping="Wrap"
        Margin="0,5,0,10"
      />
    </StackPanel>
    <ListBox x:Name="Esquemas" Grid.Row="1" DisplayMemberPath="Proveedor" />
    <TextBlock
      x:Name="Estado"
      Grid.Row="2"
      TextWrapping="Wrap"
      Margin="0,8"
      Foreground="{DynamicResource Hormiguero.Error}"
    />
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
      <Button Content="Nuevo" Click="Nuevo_Click" Padding="12,6" Margin="4" />
      <Button Content="Editar" Click="Editar_Click" Padding="12,6" Margin="4" />
      <Button Content="Desactivar" Click="Desactivar_Click" Padding="12,6" Margin="4" />
      <Button Content="Cerrar" IsCancel="True" Padding="12,6" Margin="4" />
    </WrapPanel>
  </Grid>
</Window>
