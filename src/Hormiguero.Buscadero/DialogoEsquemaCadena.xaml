<Window
  x:Class="Buscadero.App.DialogoEsquemaCadena"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Esquema del proveedor"
  Width="900"
  Height="650"
  MinWidth="700"
  MinHeight="540"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="PasoTitulo" FontSize="22" FontWeight="Bold" />
      <TextBlock
        x:Name="Ayuda"
        TextWrapping="Wrap"
        Margin="0,6,0,14"
        Foreground="{DynamicResource Hormiguero.TextoSecundario}"
      />
    </StackPanel>
    <Grid Grid.Row="1">
      <StackPanel x:Name="PasoProveedor">
        <TextBlock Text="Proveedor" FontWeight="Bold" />
        <ComboBox x:Name="Proveedor" IsEditable="True" IsTextSearchEnabled="True" Margin="0,8" />
        <TextBlock
          Text="Solo puede haber un esquema por proveedor. Si ya existe, se actualizará al guardar."
          TextWrapping="Wrap"
        />
      </StackPanel>
      <Grid x:Name="PasoDocumentos" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
          MaxHeight="105"
          VerticalScrollBarVisibility="Auto"
          Margin="0,0,0,8"
          Background="{DynamicResource Hormiguero.Superficie}"
        >
          <TextBlock
            x:Name="Compartidos"
            Text="Pistas: estos tipos ya comparten datos (pueden ir en la misma cadena)"
            TextWrapping="Wrap"
            Padding="10"
          />
        </ScrollViewer>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,8,0">
            <TextBlock
              Text="Documentos disponibles"
              FontWeight="Bold"
              DockPanel.Dock="Top"
              Margin="0,0,0,5"
            />
            <ListBox
              x:Name="TiposDisponibles"
              DisplayMemberPath="Texto"
              MouseDoubleClick="Disponible_DoubleClick"
            />
          </DockPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4">
            <Button
              x:Name="BotonAgregarTipo"
              Content="Agregar →"
              Click="AgregarTipo_Click"
              Margin="0,3"
            />
            <Button
              x:Name="BotonQuitarTipo"
              Content="← Quitar"
              Click="QuitarTipo_Click"
              Margin="0,3"
            />
          </StackPanel>
          <DockPanel Grid.Column="2" Margin="8,0,0,0">
            <TextBlock
              Text="Documentos del proceso, en orden"
              FontWeight="Bold"
              DockPanel.Dock="Top"
              Margin="0,0,0,5"
            />
            <ListBox
              x:Name="TiposProceso"
              DisplayMemberPath="Texto"
              MouseDoubleClick="Proceso_DoubleClick"
            />
          </DockPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
          <Button x:Name="BotonSubirTipo" Content="Subir" Click="Subir_Click" Margin="0,0,6,0" />
          <Button x:Name="BotonBajarTipo" Content="Bajar" Click="Bajar_Click" Margin="0,0,6,0" />
          <TextBlock Text="El orden de esta lista se guarda en el esquema." Margin="6,4" />
        </StackPanel>
      </Grid>
      <StackPanel x:Name="PasoInicio" Visibility="Collapsed">
        <TextBlock Text="Marque uno o varios documentos que puedan iniciar una cadena. El cambio queda visible en el resumen." />
        <ListBox x:Name="Inicios" Margin="0,8">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox
                Content="{Binding Nombre}"
                IsChecked="{Binding Inicia, Mode=TwoWay}"
                Padding="5"
              />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
      <StackPanel x:Name="PasoParejas" Visibility="Collapsed">
        <TextBlock
          Text="Cada documento de un lugar tiene uno solo del otro (por ejemplo, cada guía su factura)."
          TextWrapping="Wrap"
        />
        <ComboBox x:Name="LugarA" Margin="0,10,0,4" />
        <ComboBox x:Name="LugarB" Margin="0,4" />
        <ComboBox x:Name="DatoPareja" Margin="0,4" />
        <WrapPanel Margin="0,8">
          <Button Content="Agregar pareja 1 a 1" Click="AgregarPareja_Click" Margin="0,0,6,0" />
          <Button Content="Quitar pareja" Click="QuitarPareja_Click" />
        </WrapPanel>
        <ListBox x:Name="Parejas" />
      </StackPanel>
      <StackPanel x:Name="PasoModos" Visibility="Collapsed">
        <TextBlock
          Text="Por ejemplo Retiro o Despacho: cada modo puede tener avisos distintos."
          TextWrapping="Wrap"
        />
        <WrapPanel Margin="0,8">
          <TextBox x:Name="NuevoModo" Width="220" />
          <Button Content="Agregar" Click="AgregarModo_Click" Margin="6,0" />
          <Button Content="Quitar" Click="QuitarModo_Click" />
        </WrapPanel>
        <ListBox x:Name="Modos" Height="150" DisplayMemberPath="." />
        <TextBlock Text="¿Qué documento decide el modo?" Margin="0,12,0,4" />
        <ComboBox x:Name="LugarDecideModo" DisplayMemberPath="Nombre" SelectedValuePath="Orden" />
      </StackPanel>
      <StackPanel x:Name="PasoAvisos" Visibility="Collapsed">
        <TextBlock
          Text="Configure avisos por lugar y modo. La frase completa se guarda para revisar."
          TextWrapping="Wrap"
        />
        <WrapPanel Margin="0,8">
          <Button Content="Agregar aviso…" Click="AgregarAviso_Click" Margin="0,0,6,0" />
          <Button Content="Editar" Click="EditarAviso_Click" Margin="0,0,6,0" />
          <Button Content="Quitar" Click="QuitarAviso_Click" />
        </WrapPanel>
        <ListBox x:Name="Avisos" Height="300" DisplayMemberPath="Frase" />
      </StackPanel>
      <ScrollViewer x:Name="PasoResumen" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="Resumen" TextWrapping="Wrap" />
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Cambiar proveedor" Tag="1" Click="Cambiar_Click" Margin="0,0,6,4" />
            <Button Content="Cambiar documentos" Tag="2" Click="Cambiar_Click" Margin="0,0,6,4" />
            <Button Content="Cambiar inicios" Tag="3" Click="Cambiar_Click" Margin="0,0,6,4" />
            <Button Content="Cambiar parejas" Tag="4" Click="Cambiar_Click" Margin="0,0,6,4" />
            <Button Content="Cambiar modos" Tag="5" Click="Cambiar_Click" Margin="0,0,6,4" />
            <Button Content="Cambiar avisos" Tag="6" Click="Cambiar_Click" Margin="0,0,6,4" />
          </WrapPanel>
          <TextBlock Text="Ejemplo del árbol" FontWeight="Bold" Margin="0,12,0,5" />
          <ItemsControl x:Name="DibujoArbol" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock
      x:Name="Estado"
      Grid.Row="2"
      TextWrapping="Wrap"
      Margin="0,8"
      Foreground="{DynamicResource Hormiguero.Error}"
    />
    <DockPanel Grid.Row="3">
      <TextBlock x:Name="NumeroPaso" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Atrás" Click="Atras_Click" Padding="12,6" Margin="4,0" />
        <Button
          x:Name="Siguiente"
          Content="Siguiente"
          Click="Siguiente_Click"
          Padding="12,6"
          Margin="4,0"
        />
        <Button
          x:Name="Guardar"
          Content="Guardar"
          Click="Guardar_Click"
          Padding="12,6"
          Margin="4,0"
          Visibility="Collapsed"
        />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
