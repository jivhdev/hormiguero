<Window
  x:Class="Buscadero.App.DialogoModeloGuiado"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Crear nuevo modelo de cadena"
  Height="620"
  Width="640"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock
        x:Name="TextoBreadcrumb"
        FontWeight="Bold"
        TextWrapping="Wrap"
        Visibility="Collapsed"
        Margin="0,0,0,2"
      />
      <TextBlock
        x:Name="TextoSubtitulo"
        TextWrapping="Wrap"
        Foreground="DimGray"
        Visibility="Collapsed"
        Margin="0,0,0,10"
      />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="Nombre del modelo:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox
        x:Name="TextoModelo"
        Width="240"
        Margin="0,0,8,0"
        VerticalContentAlignment="Center"
      />
      <Button
        x:Name="BotonComenzar"
        Content="Comenzar"
        Padding="10,4"
        Click="BotonComenzar_Click"
      />
    </StackPanel>

    <StackPanel x:Name="PanelCuerpo" DockPanel.Dock="Top" Visibility="Collapsed">
      <TextBlock
        x:Name="TextoAyuda"
        TextWrapping="Wrap"
        Margin="0,0,0,8"
        Text="Agregue los documentos del modelo en orden. Se necesitan al menos dos."
      />
      <TextBlock Text="Documento:" />
      <TextBox x:Name="TextoDocumento" Width="320" Margin="0,4,0,6" HorizontalAlignment="Left" />
      <CheckBox
        x:Name="CheckMultiple"
        Content="Documento ramificado (abre cadenas hijas de otro modelo)"
        Margin="0,0,0,6"
        Checked="CheckMultiple_Changed"
        Unchecked="CheckMultiple_Changed"
      />
      <StackPanel
        x:Name="PanelModeloHijo"
        Orientation="Horizontal"
        Margin="20,0,0,8"
        IsEnabled="False"
      >
        <TextBlock Text="Modelo de cadena hija:" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox x:Name="ComboModeloHijo" Width="300" DisplayMemberPath="Etiqueta" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button
          x:Name="BotonAgregarDocumento"
          Content="Agregar documento"
          Padding="8,4"
          Margin="0,0,6,0"
          Click="BotonAgregarDocumento_Click"
        />
        <CheckBox
          x:Name="CheckAnexo"
          Content="Es anexo del último documento"
          VerticalAlignment="Center"
        />
      </StackPanel>

      <TextBlock Text="Documentos de este modelo:" Margin="0,4,0,4" />
      <ListBox x:Name="Lista" Height="170" DisplayMemberPath="Texto" />
    </StackPanel>

    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,10,0,0"
    >
      <Button
        x:Name="BotonFinalizar"
        Content="Completado"
        Width="110"
        Margin="0,0,8,0"
        IsEnabled="False"
        Click="BotonFinalizar_Click"
      />
      <Button Content="Cancelar" IsCancel="True" Width="90" />
    </StackPanel>
  </DockPanel>
</Window>
