<UserControl
  x:Class="Buscadero.App.PanelBusquedaSecundario"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  MinWidth="360"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Segunda búsqueda" FontWeight="Bold" Margin="0,0,0,6" />
      <WrapPanel>
        <TextBox
          x:Name="TextoNumero"
          Width="120"
          Margin="0,0,6,4"
          VerticalContentAlignment="Center"
          ToolTip="Número de documento"
          KeyDown="TextoNumero_KeyDown"
        />
        <ComboBox
          x:Name="ComboAlcance"
          Width="135"
          SelectedIndex="0"
          Margin="0,0,6,4"
          SelectionChanged="ComboAlcance_SelectionChanged"
        >
          <ComboBoxItem Content="Primera coincidencia" />
          <ComboBoxItem Content="Todas las carpetas" />
          <ComboBoxItem Content="Carpeta específica" />
        </ComboBox>
        <ComboBox x:Name="ComboModo" Width="105" SelectedIndex="0" Margin="0,0,6,4">
          <ComboBoxItem Content="Todos" />
          <ComboBoxItem Content="Exacto" />
          <ComboBoxItem Content="Alfanumérico" />
          <ComboBoxItem Content="Solo número" />
          <ComboBoxItem Content="Solo letras" />
        </ComboBox>
        <Button
          x:Name="BotonBuscar"
          Content="Buscar"
          Padding="8,3"
          Margin="0,0,6,4"
          Click="BotonBuscar_Click"
        />
        <ComboBox
          x:Name="ComboFiltroCarpeta"
          Width="180"
          IsEditable="True"
          IsEnabled="False"
          Margin="0,0,6,4"
          IsTextSearchEnabled="False"
          ToolTip="Carpeta específica"
        />
      </WrapPanel>
      <ProgressBar
        x:Name="BarraProgreso"
        Height="5"
        IsIndeterminate="True"
        Visibility="Collapsed"
      />
      <TextBlock x:Name="TextoEstado" TextWrapping="Wrap" Margin="0,3,0,3" />
      <ListView
        x:Name="ListaResultados"
        Height="78"
        Visibility="Collapsed"
        MouseDoubleClick="ListaResultados_MouseDoubleClick"
        DisplayMemberPath="Nombre"
      />
    </StackPanel>
    <WrapPanel Grid.Row="1" x:Name="BarraVisor" Visibility="Collapsed" Margin="0,0,0,4">
      <TextBlock
        x:Name="TextoDocumento"
        FontWeight="Bold"
        MaxWidth="145"
        TextTrimming="CharacterEllipsis"
        VerticalAlignment="Center"
        Margin="0,0,6,0"
      />
      <Button
        Content="Ver carpeta"
        Padding="5,2"
        Margin="0,0,4,0"
        Click="BotonVerEnCarpeta_Click"
      />
      <Button
        x:Name="BotonImprimir"
        Content="Imprimir ▾"
        Padding="5,2"
        Margin="0,0,4,0"
        IsEnabled="False"
        Click="BotonImprimir_Click"
      >
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Primera página" Tag="PrimeraPagina" Click="OpcionImprimir_Click" />
            <MenuItem
              Header="Primeras 2 páginas"
              Tag="PrimerasDosPaginas"
              Click="OpcionImprimir_Click"
            />
            <MenuItem
              Header="Todo el documento"
              Tag="DocumentoCompleto"
              Click="OpcionImprimir_Click"
            />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
      <Button Content="Anterior" Padding="5,2" Margin="0,0,4,0" Click="BotonPaginaAnterior_Click" />
      <TextBlock x:Name="TextoPagina" VerticalAlignment="Center" Margin="0,0,4,0" />
      <Button
        Content="Siguiente"
        Padding="5,2"
        Margin="0,0,6,0"
        Click="BotonPaginaSiguiente_Click"
      />
      <ToggleButton x:Name="BotonModoMarcas" Content="Marcas" Padding="5,2" Margin="0,0,4,0" />
      <ComboBox
        x:Name="ComboHerramienta"
        Width="75"
        SelectedIndex="0"
        VerticalContentAlignment="Center"
      >
        <ComboBoxItem Content="Tick" />
        <ComboBoxItem Content="X" />
        <ComboBoxItem Content="Raya" />
        <ComboBoxItem Content="Círculo" />
        <ComboBoxItem Content="Texto" />
      </ComboBox>
    </WrapPanel>
    <Grid Grid.Row="2" Height="0" />
    <Border
      Grid.Row="3"
      BorderBrush="{DynamicResource Hormiguero.Borde}"
      BorderThickness="1"
      Background="{DynamicResource Hormiguero.Encabezado}"
    >
      <Grid>
        <ScrollViewer
          x:Name="LienzoVisor"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          PreviewMouseWheel="LienzoVisor_PreviewMouseWheel"
        >
          <Grid x:Name="ContenedorPagina" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image
              x:Name="ImagenPdf"
              Stretch="None"
              RenderOptions.BitmapScalingMode="HighQuality"
            />
            <Canvas
              x:Name="CanvasMarcas"
              Background="Transparent"
              MouseLeftButtonDown="CanvasMarcas_MouseLeftButtonDown"
            />
          </Grid>
        </ScrollViewer>
        <TextBlock
          x:Name="TextoVisorVacio"
          Text="Ingrese otro número y busque."
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Hormiguero.TextoSecundario}"
          TextWrapping="Wrap"
          Margin="12"
        />
      </Grid>
    </Border>
  </Grid>
</UserControl>
