<Window
  x:Class="Buscadero.App.DialogoRecordatorio"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Recordarme"
  Height="300"
  Width="500"
  MinHeight="260"
  MinWidth="420"
  Background="{DynamicResource Hormiguero.Fondo}"
  Foreground="{DynamicResource Hormiguero.Texto}"
>
  <StackPanel Margin="20">
    <TextBlock Text="¿Qué quiere recordar?" Margin="0,0,0,5" />
    <TextBox x:Name="Texto" MinHeight="36" Padding="8" />
    <TextBlock Text="Fecha" Margin="0,12,0,5" />
    <DatePicker
      x:Name="Fecha"
      SelectedDate="{x:Static sys:DateTime.Today}"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
    />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Guardar aviso" Padding="14,9" Margin="0,0,8,0" Click="Guardar_Click" />
      <Button Content="Cancelar" Padding="14,9" Click="Cancelar_Click" />
    </StackPanel>
  </StackPanel>
</Window>
