<Window
  x:Class="Buscadero.App.DialogoLista"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Seleccionar"
  Height="320"
  Width="420"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
>
  <DockPanel Margin="12">
    <TextBlock
      x:Name="Etiqueta"
      DockPanel.Dock="Top"
      Text="Seleccione una opción:"
      Margin="0,0,0,8"
    />
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,8,0,0"
    >
      <Button
        Content="Aceptar"
        IsDefault="True"
        Width="90"
        Margin="0,0,8,0"
        Click="Aceptar_Click"
      />
      <Button Content="Cancelar" IsCancel="True" Width="90" />
    </StackPanel>
    <ListBox x:Name="Lista" DisplayMemberPath="Etiqueta" />
  </DockPanel>
</Window>
