<Window
  x:Class="Buscadero.App.DialogoDudosos"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Lista de dudosos"
  Width="760"
  Height="610"
  MinWidth="620"
  MinHeight="480"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock
        x:Name="TextoContador"
        FontSize="18"
        FontWeight="Bold"
        Foreground="{DynamicResource Hormiguero.Texto}"
      />
      <TextBlock
        Text="Revise los datos y el motivo antes de decidir."
        TextWrapping="Wrap"
        Foreground="{DynamicResource Hormiguero.TextoSecundario}"
      />
    </StackPanel>
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,10,0,0"
    >
      <Button Content="Ver archivo" Padding="10,5" Margin="0,0,8,0" Click="VerArchivo_Click" />
      <Button
        Content="Enlazar"
        IsDefault="True"
        Padding="10,5"
        Margin="0,0,8,0"
        Click="Enlazar_Click"
      />
      <Button Content="No corresponde" Padding="10,5" Margin="0,0,8,0" Click="Rechazar_Click" />
      <Button Content="Cerrar" IsCancel="True" Padding="10,5" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="ListaDudosos" SelectionChanged="Lista_SelectionChanged" Margin="0,0,10,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4">
              <TextBlock Text="{Binding NombreDocumento}" TextWrapping="Wrap" FontWeight="Bold" />
              <TextBlock
                Text="{Binding NombreVagon}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource Hormiguero.TextoSecundario}"
              />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border
        Grid.Column="1"
        BorderBrush="{DynamicResource Hormiguero.Borde}"
        BorderThickness="1"
        Padding="12"
      >
        <StackPanel>
          <TextBlock Text="Cadena para enlazar" FontWeight="Bold" />
          <ComboBox
            x:Name="ListaCadenas"
            DisplayMemberPath="Nombre"
            Margin="0,4,0,12"
            Visibility="Collapsed"
          />
          <TextBlock Text="Documentos" FontWeight="Bold" />
          <TextBlock x:Name="TextoDocumentos" TextWrapping="Wrap" Margin="0,4,0,12" />
          <TextBlock Text="Datos comparados" FontWeight="Bold" />
          <TextBlock x:Name="TextoDatos" TextWrapping="Wrap" Margin="0,4,0,12" />
          <TextBlock Text="Motivo" FontWeight="Bold" />
          <TextBlock x:Name="TextoMotivo" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
