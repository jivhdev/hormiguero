<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fase A de D-65: Buscadero (caso 15) traído sin cambiar su comportamiento.
       Conserva su nombre de programa, su espacio de nombres y su carpeta Datos junto al programa. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Buscadero</AssemblyName>
    <RootNamespace>Buscadero.App</RootNamespace>
    <ApplicationTitle>Buscadero</ApplicationTitle>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hormiguero.Buscadero.Core\Hormiguero.Buscadero.Core.csproj" />
    <ProjectReference Include="..\Hormiguero.Diseno\Hormiguero.Diseno.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFtoImage" />
  </ItemGroup>

  <Target Name="QuitarSimbolosDelPublish" AfterTargets="Publish">
    <ItemGroup>
      <SimbolosDelPublish Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(SimbolosDelPublish)" />
  </Target>
</Project>
